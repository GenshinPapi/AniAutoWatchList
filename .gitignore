# The bundled patched ani-cli script should be committed, but the upstream
# clone metadata should not be. This avoids Git treating ani-cli/ as an
# embedded repository when someone creates the upload repo.
ani-cli/.git/
ani-cli/.github/
ani-cli/.assets/
