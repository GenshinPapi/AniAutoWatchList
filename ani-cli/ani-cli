derive_allanime_key_hex() {
    _key_a=$1
    _key_b=$2
    [ -n "$_key_a" ] && [ -n "$_key_b" ] || return 1

    if command -v node >/dev/null 2>&1; then
        # shellcheck disable=SC2016
        node -e '
const keyA = Buffer.from(process.argv[1] || "", "hex");
const keyB = Buffer.from(process.argv[2] || "", "base64");
if (!keyA.length || !keyB.length) process.exit(2);
const key = Buffer.alloc(Math.min(keyA.length, keyB.length));
for (let i = 0; i < key.length; i += 1) key[i] = keyA[i] ^ keyB[i];
process.stdout.write(key.toString("hex"));
' "$_key_a" "$_key_b" 2>/dev/null && return 0
    fi

    _python_cmd="$(ani_watch_python || true)"
    if [ -n "$_python_cmd" ]; then
        "$_python_cmd" -c '
import base64
import sys

key_a = bytes.fromhex(sys.argv[1])
key_b = base64.b64decode(sys.argv[2])
sys.stdout.write(bytes(a ^ b for a, b in zip(key_a, key_b)).hex())
' "$_key_a" "$_key_b" 2>/dev/null && return 0
    fi

    _key_b_hex="$(printf '%s' "$_key_b" | base64 -d 2>/dev/null | od -A n -t x1 | tr -d ' \n' || true)"
    _key_a_len=$(printf '%s' "$_key_a" | wc -c | tr -d ' ')
    _key_b_len=$(printf '%s' "$_key_b_hex" | wc -c | tr -d ' ')
    [ "$_key_a_len" -ge 64 ] && [ "$_key_b_len" -ge 64 ] || return 1

    _xor_out=""
    _xor_i=1
    while [ "$_xor_i" -le 64 ]; do
        _xor_a="$(printf '%s' "$_key_a" | cut -c"$_xor_i-$((_xor_i + 1))")"
        _xor_b="$(printf '%s' "$_key_b_hex" | cut -c"$_xor_i-$((_xor_i + 1))")"
        _xor_out="${_xor_out}$(printf '%02x' "$((0x$_xor_a ^ 0x$_xor_b))")"
        _xor_i=$((_xor_i + 2))
    done
    printf '%s' "$_xor_out"
}

allanime_crypto_cache_file() {
    _cache_home=${XDG_CACHE_HOME:-}
    [ -z "$_cache_home" ] && [ -n "${HOME:-}" ] && _cache_home="$HOME/.cache"
