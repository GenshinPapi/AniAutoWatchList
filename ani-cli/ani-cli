# GET $@ through curl_cffi with a real browser TLS fingerprint; 127 if unavailable, 2 on a Cloudflare challenge
impersonate_curl() {
    _impersonate_python="$(ani_watch_python || true)"
    [ -n "$_impersonate_python" ] || return 127

    "$_impersonate_python" - "$@" <<'PY'
import sys

try:
    from curl_cffi import requests
except Exception:
    raise SystemExit(127)

args = sys.argv[1:]
url = ""
timeout = 15.0
headers = {}
i = 0
while i < len(args):
    arg = args[i]
    if arg in ("-A", "--user-agent") and i + 1 < len(args):
        headers["User-Agent"] = args[i + 1]
        i += 2
    elif arg in ("-H", "--header") and i + 1 < len(args):
        name, sep, value = args[i + 1].partition(":")
        if sep:
            headers[name.strip()] = value.strip()
        i += 2
    elif arg == "--max-time" and i + 1 < len(args):
        try:
            timeout = float(args[i + 1])
        except ValueError:
            timeout = 15.0
        i += 2
    elif arg.startswith("--max-time="):
        try:
            timeout = float(arg.split("=", 1)[1])
        except ValueError:
            timeout = 15.0
        i += 1
    elif arg == "--connect-timeout" and i + 1 < len(args):
        i += 2
    elif not arg.startswith("-") and not url:
        url = arg
        i += 1
    else:
        i += 1

if not url:
    raise SystemExit(1)

headers.setdefault(
    "User-Agent",
    "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
)

try:
    response = requests.get(url, headers=headers, timeout=timeout, impersonate="chrome124", allow_redirects=True)
except Exception:
    raise SystemExit(1)

text = response.text.replace("\r", "")
# a bare challenges.cloudflare.com reference is not enough: providers embed the
# Turnstile widget on ordinary pages, so only interstitial-specific markers count
challenge_markers = (
    "<title>just a moment",
    "<title>attention required!",
    "cf_chl",
    "enable javascript and cookies",
)
if any(marker.lower() in text.lower() for marker in challenge_markers):
    raise SystemExit(2)
if response.status_code >= 400 and not text:
    raise SystemExit(1)

sys.stdout.write(text)
PY
}

# fetches $2.. with browser impersonation, falling back to plain curl with retries
# $1 is the provider label used in the error text stored in provider_last_error
provider_curl() {
    _provider_label="$1"
    shift
    provider_last_error=""
    _provider_result="$(impersonate_curl "$@")"
    _provider_status=$?
    if [ "$_provider_status" -eq 0 ] && [ -n "$_provider_result" ]; then
        printf '%s' "$_provider_result"
        return 0
    fi
    if [ "$_provider_status" -eq 2 ]; then
        provider_last_error="$_provider_label returned a Cloudflare browser challenge"
        return 2
    fi

    _provider_retries=2
    _provider_result=""
    while [ "$_provider_retries" -gt 0 ]; do
        _provider_result="$(curl -sL --connect-timeout 5 --max-time 15 "$@" 2>/dev/null | tr -d '\r')"
        if printf '%s' "$_provider_result" | grep -qiE '<title>Just a moment|<title>Attention Required!|cf_chl|Enable JavaScript and cookies'; then
            provider_last_error="$_provider_label returned a Cloudflare browser challenge"
            return 2
        fi
        if [ -n "$_provider_result" ]; then
            printf '%s' "$_provider_result"
            return 0
        fi
        _provider_retries=$((_provider_retries - 1))
        [ "$_provider_retries" -gt 0 ] && sleep 1
    done
    provider_last_error="$_provider_label returned an empty response"
    return 1
}

anidb_curl() {
    provider_curl "anidb.app" "$@"
    _anidb_status=$?
    anidb_last_error="$provider_last_error"
    return "$_anidb_status"
}

hianime_curl() {
    provider_curl "hianime.at" "$@"
    _hianime_status=$?
    hianime_last_error="$provider_last_error"
    return "$_hianime_status"
}

provider_query_string() {
    printf '%s' "$1" |
        sed 's/([^)]*)//g;s/[^[:alnum:] ]/ /g;s/[[:space:]][[:space:]]*/ /g;s/^ //;s/ $//;s/ /+/g'
}

provider_normalize_title() {
    printf '%s' "$1" |
        tr '[:upper:]' '[:lower:]' |
        sed 's/([^)]*)//g;s/[^[:alnum:]]/ /g;s/[[:space:]][[:space:]]*/ /g;s/^ //;s/ $//'
}

search_anidb() {
    _anidb_query="$(provider_query_string "$1")"
    [ -n "$_anidb_query" ] || return 1

    _anidb_page="$(anidb_curl "https://anidb.app/search/suggestions?q=${_anidb_query}" -A "$anidb_agent" --max-time 15)"
    _anidb_status=$?
    if [ -z "$_anidb_page" ]; then
        _anidb_page="$(anidb_curl "https://anidb.app/browse?q=${_anidb_query}" -A "$anidb_agent" --max-time 15)"
        _anidb_status=$?
    fi
    if [ -z "$_anidb_page" ]; then
        [ "$_anidb_status" -eq 2 ] && return 2
        return 1
    fi
    # anidb.app answers every route with a 503 maintenance page while it is offline
    printf '%s' "$_anidb_page" | grep -qiE '<title>[^<]*maintenance' && return 3

    printf '%s' "$_anidb_page" |
        tr '\n' ' ' |
        sed 's/<a href/\n<a href/g' |
        sed -nE 's|.*anime/[a-z0-9-]+-([0-9]+)".*alt="([^"]+)".*|\1	\2|p;s|.*href="/anime/[^"]*-([0-9]+)".*>([^<]+)</a>.*|\1	\2|p' |
        sed 's/&amp;/\&/g;s/&#39;/'"'"'/g;s/&quot;/"/g' |
        awk -F '\t' 'NF >= 2 && !seen[$1]++ { print $1 "\t" $2 }'
}

anidb_resolve_id() {
    _anidb_title="$1"
    [ -n "$_anidb_title" ] || _anidb_title="$allanime_title"
    [ -n "$_anidb_title" ] || return 1

    _anidb_results="$(search_anidb "$_anidb_title")"
    _anidb_status=$?
    if [ -z "$_anidb_results" ]; then
        if [ "$_anidb_status" -eq 2 ]; then
            anidb_last_error="anidb.app returned a Cloudflare browser challenge"
            return 2
        elif [ "$_anidb_status" -eq 3 ]; then
            anidb_last_error="anidb.app is down for maintenance"
            return 3
        else
            anidb_last_error="anidb.app did not return a matching anime"
            return 1
        fi
    fi

    _anidb_want="$(provider_normalize_title "$_anidb_title")"
    _anidb_first="$(printf '%s\n' "$_anidb_results" | head -n 1 | cut -f1)"
    while IFS='	' read -r _anidb_id _anidb_name; do
        [ -n "$_anidb_id" ] || continue
        _anidb_have="$(provider_normalize_title "$_anidb_name")"
        [ "$_anidb_have" = "$_anidb_want" ] && printf '%s' "$_anidb_id" && return 0
    done <<EOF
$_anidb_results
EOF
    [ -n "$_anidb_first" ] && printf '%s' "$_anidb_first"
}

anidb_episode_id() {
    _anidb_ep_json="$1"
    _anidb_ep_no="$2"
    _anidb_python="$(ani_watch_python || true)"
    if [ -n "$_anidb_python" ]; then
        printf '%s' "$_anidb_ep_json" | "$_anidb_python" -c '
import json
import sys

episode_no = sys.argv[1]
try:
    payload = json.load(sys.stdin)
except Exception:
    raise SystemExit(1)

episodes = payload if isinstance(payload, list) else payload.get("episodes", [])
if not isinstance(episodes, list):
    raise SystemExit(1)

def same_number(value, wanted):
    return value is not None and str(value) == wanted

for episode in episodes:
    if not isinstance(episode, dict):
        continue
    if same_number(episode.get("number"), episode_no) or same_number(episode.get("number2"), episode_no):
        episode_id = episode.get("id")
        if episode_id is not None:
            print(episode_id)
            raise SystemExit(0)

try:
    relative_index = int(episode_no)
except ValueError:
    raise SystemExit(1)

if relative_index < 1 or relative_index > len(episodes):
    raise SystemExit(1)

episode = episodes[relative_index - 1]
if isinstance(episode, dict) and episode.get("id") is not None:
    print(episode["id"])
    raise SystemExit(0)

raise SystemExit(1)
' "$_anidb_ep_no" 2>/dev/null && return 0
    fi

    _anidb_ep_re="$(printf '%s' "$_anidb_ep_no" | sed "s/[.[\\*^\$()+?{}|]/\\\\&/g")"
    printf '%s' "$_anidb_ep_json" |
        tr '\n' ' ' |
        sed 's/},{/}\n{/g' |
        sed -nE "s|.*\"id\":([0-9]+).*\"number\":${_anidb_ep_re}([,}].*)|\1|p;s|.*\"number\":${_anidb_ep_re}([,}].*).*\"id\":([0-9]+).*|\2|p" |
        head -n 1
}

anidb_embed_url() {
    _anidb_lang_json="$1"
    _anidb_lang="jpn"
    [ "$mode" = "dub" ] && _anidb_lang="eng"

    if command -v python3 >/dev/null 2>&1; then
        printf '%s' "$_anidb_lang_json" | python3 -c '
import json
import sys

preferred = sys.argv[1]
try:
    payload = json.load(sys.stdin)
except Exception:
    raise SystemExit(1)

items = payload if isinstance(payload, list) else payload.get("languages", [])
if not isinstance(items, list):
    raise SystemExit(1)

fallback = ""
for item in items:
    if not isinstance(item, dict):
        continue
    url = item.get("embed_url") or item.get("embedUrl") or item.get("url") or ""
    if not url:
        continue
    if not fallback:
        fallback = url
    if item.get("code") == preferred:
        print(url)
        raise SystemExit(0)

if fallback:
    print(fallback)
' "$_anidb_lang" 2>/dev/null && return 0
    fi

    _anidb_embed="$(printf '%s' "$_anidb_lang_json" | sed -nE "s|.*\"code\":\"${_anidb_lang}\".*\"embed_url\":\"([^\"]*)\".*|\1|p;s|.*\"embed_url\":\"([^\"]*)\".*\"code\":\"${_anidb_lang}\".*|\1|p" | head -n 1)"
    [ -z "$_anidb_embed" ] && _anidb_embed="$(printf '%s' "$_anidb_lang_json" | sed -nE 's|.*"embed_url":"([^"]*)".*|\1|p' | head -n 1)"
    printf '%s' "$_anidb_embed" | sed 's|\\/|/|g'
}

# turns an HLS master playlist into the "quality >url" lines select_quality expects
hls_playlist_links() {
    _hls_playlist_url="$1"
    _hls_playlist="$2"
    _hls_base_url="${_hls_playlist_url%/*}/"

    printf '%s' "$_hls_playlist" | awk -v base="$_hls_base_url" '
/^#EXT-X-STREAM/ {
    q = $0
    sub(/^.*RESOLUTION=[0-9]+x/, "", q)
    sub(/,.*/, "", q)
    if (q ~ /^[0-9]+$/) q = q "p"
    else q = "Hls"
    next
}
/^#/ || /^$/ { next }
{
    u = $0
    if (u !~ /^https?:\/\//) u = base u
    if (q == "") q = "Hls"
    print q " >" u
    q = ""
}
' | sort -rn
}

anidb_fetch_episode_links() {
    _anidb_title="${1:-$title}"
    [ -n "$_anidb_title" ] || _anidb_title="$allanime_title"
    [ -n "$_anidb_title" ] || return 1

    _anidb_id="$(anidb_resolve_id "$_anidb_title")"
    _anidb_status=$?
    if [ -z "$_anidb_id" ]; then
        if [ "$_anidb_status" -eq 2 ]; then
            anidb_last_error="anidb.app returned a Cloudflare browser challenge"
        elif [ "$_anidb_status" -eq 3 ]; then
            anidb_last_error="anidb.app is down for maintenance"
        else
            anidb_last_error="anidb.app did not return a matching anime"
        fi
        return 1
    fi

    _anidb_ep_json="$(anidb_curl "https://anidb.app/api/frontend/anime/${_anidb_id}/episodes" -A "$anidb_agent" -H "Accept: application/json" --max-time 15)"
    _anidb_status=$?
    if [ -z "$_anidb_ep_json" ]; then
        if [ "$_anidb_status" -eq 2 ]; then
            anidb_last_error="anidb.app returned a Cloudflare browser challenge"
        else
            anidb_last_error="anidb.app did not return episodes for ${_anidb_title}"
        fi
        return 1
    fi

    _anidb_ep_id="$(anidb_episode_id "$_anidb_ep_json" "$ep_no" || true)"
    if [ -z "$_anidb_ep_id" ]; then
        anidb_last_error="anidb.app did not expose episode ${ep_no} for ${_anidb_title}"
        return 1
    fi

    _anidb_lang_json="$(anidb_curl "https://anidb.app/api/frontend/episode/${_anidb_ep_id}/languages" -A "$anidb_agent" -H "Accept: application/json" --max-time 15)"
    _anidb_status=$?
    if [ -z "$_anidb_lang_json" ]; then
        if [ "$_anidb_status" -eq 2 ]; then
            anidb_last_error="anidb.app returned a Cloudflare browser challenge"
        else
            anidb_last_error="anidb.app did not return streams for episode ${ep_no}"
        fi
        return 1
    fi

    _anidb_embed_url="$(anidb_embed_url "$_anidb_lang_json" || true)"
    if [ -z "$_anidb_embed_url" ]; then
        anidb_last_error="anidb.app returned no ${mode} embed for episode ${ep_no}"
        return 1
    fi

    _anidb_embed_page="$(anidb_curl "$_anidb_embed_url" -A "$anidb_agent" --max-time 15)"
    _anidb_status=$?
    if [ -z "$_anidb_embed_page" ]; then
        if [ "$_anidb_status" -eq 2 ]; then
            anidb_last_error="anidb.app returned a Cloudflare browser challenge"
        else
            anidb_last_error="anidb.app embed returned an empty response"
        fi
        return 1
    fi

    _anidb_m3u8="$(printf '%s' "$_anidb_embed_page" | sed -nE "s|.*file:[[:space:]]*'([^']*)'.*|\1|p;s|.*file:[[:space:]]*\"([^\"]*)\".*|\1|p" | head -n 1)"
    _anidb_m3u8="$(printf '%s' "$_anidb_m3u8" | sed 's|\\/|/|g')"
    if [ -z "$_anidb_m3u8" ]; then
        anidb_last_error="anidb.app embed did not expose an HLS playlist"
        return 1
    fi

    _anidb_m3u8_content="$(anidb_curl "$_anidb_m3u8" -A "$anidb_agent" --max-time 15)"
    _anidb_status=$?
    if ! printf '%s' "$_anidb_m3u8_content" | grep -q "EXTM3U"; then
        if [ "$_anidb_status" -eq 2 ]; then
            anidb_last_error="anidb.app returned a Cloudflare browser challenge"
        else
            anidb_last_error="anidb.app playlist was not valid HLS"
        fi
        return 1
    fi

    hls_playlist_links "$_anidb_m3u8" "$_anidb_m3u8_content"
}

# hianime.at is the playback fallback used when anidb.app cannot serve an episode.
# Search, the episode list, and every hook still come from the AllAnime path above;
# only the stream links for the already selected title and episode are resolved here.

# GNU coreutils, BSD and openssl all spell base64 decoding differently
hianime_b64_decode() {
    printf '%s\n' "$1" | base64 -d 2>/dev/null ||
        printf '%s\n' "$1" | base64 -D 2>/dev/null ||
        printf '%s\n' "$1" | openssl base64 -d -A 2>/dev/null
}

# The embed page ships its player config as base64(json XOR "otaku-embed-v1").
# Runs in a subshell so the key bytes can live in the positional parameters and rotate with shift.
hianime_deobfuscate() (
    _hianime_bytes="$(hianime_b64_decode "$1" | od -v -An -tu1)"
    [ -n "$_hianime_bytes" ] || return 1
    set -- 111 116 97 107 117 45 101 109 98 101 100 45 118 49
    _hianime_out=""
    # shellcheck disable=SC2086
    for _hianime_byte in $_hianime_bytes; do
        _hianime_char=$((_hianime_byte ^ $1))
        _hianime_out="${_hianime_out}\\0$((_hianime_char / 64))$(((_hianime_char / 8) % 8))$((_hianime_char % 8))"
        set -- "$@" "$1"
        shift
    done
    printf '%b' "$_hianime_out"
)

# search the query and print "show_id<TAB>name" lines
hianime_search() {
    _hianime_query="$(provider_query_string "$1")"
    [ -n "$_hianime_query" ] || return 1

    _hianime_page="$(hianime_curl "${hianime_base}/search?keyword=${_hianime_query}" -A "$hianime_agent" --max-time 20)"
    _hianime_status=$?
    if [ -z "$_hianime_page" ]; then
        [ "$_hianime_status" -eq 2 ] && return 2
        return 1
    fi

    # the "Top 10" sidebar repeats the result markup, so drop it before flattening the page
    printf '%s' "$_hianime_page" |
        sed '/id="main-sidebar"/,$d' |
        tr '\n' ' ' |
        sed 's|<div class="film-detail">|\n<div class="film-detail">|g' |
        sed -nE 's|.*<h3 class="film-name">[[:space:]]*<a href="[^"]*/([^"/]*)"[[:space:]]*title="([^"]*)".*|\1	\2|p' |
        sed 's/&amp;/\&/g;s/&#0*39;/'"'"'/g;s/&quot;/"/g' |
        awk -F '\t' 'NF >= 2 && !seen[$1]++ { print $1 "\t" $2 }'
}

hianime_resolve_id() {
    _hianime_title="$1"
    [ -n "$_hianime_title" ] || return 1

    _hianime_results="$(hianime_search "$_hianime_title")"
    _hianime_status=$?
    if [ -z "$_hianime_results" ]; then
        [ "$_hianime_status" -eq 2 ] && return 2
        return 1
    fi

    _hianime_want="$(provider_normalize_title "$_hianime_title")"
    _hianime_first="$(printf '%s\n' "$_hianime_results" | head -n 1 | cut -f1)"
    while IFS="	" read -r _hianime_id _hianime_name; do
        [ -n "$_hianime_id" ] || continue
        _hianime_have="$(provider_normalize_title "$_hianime_name")"
        [ "$_hianime_have" = "$_hianime_want" ] && printf '%s' "$_hianime_id" && return 0
    done <<EOF
$_hianime_results
EOF
    [ -n "$_hianime_first" ] && printf '%s' "$_hianime_first"
}

# print "episode_id<TAB>episode_number" lines for a hianime show id
hianime_episodes() {
    _hianime_show_id="$1"
    [ -n "$_hianime_show_id" ] || return 1

    _hianime_ep_page="$(hianime_curl "${hianime_base}/api/theme/episode/list/${_hianime_show_id##*-}" -A "$hianime_agent" -H "Accept: application/json" --max-time 25)"
    _hianime_status=$?
    if [ -z "$_hianime_ep_page" ]; then
        [ "$_hianime_status" -eq 2 ] && return 2
        return 1
    fi

    # ids from other providers share the name-<number> shape, so confirm the slug in each episode link
    _hianime_id_re="$(printf '%s' "$_hianime_show_id" | sed "s/[.[\\*^\$()+?{}|]/\\\\&/g")"
    printf '%s' "$_hianime_ep_page" |
        sed 's|\\||g;s|ep-item|\nep-item|g' |
        sed -nE "s|.*data-number=\"([^\"]*)\".*data-id=\"([0-9]+)\".*/watch/${_hianime_id_re}[?]ep=.*|\\2	\\1|p"
}

hianime_episode_id() {
    _hianime_ep_id="$(printf '%s\n' "$1" | awk -F '\t' -v want="$2" '$2 == want { print $1; exit }')"
    if [ -z "$_hianime_ep_id" ] && [ -n "${2##*[!0-9]*}" ] && [ "$2" -gt 0 ] 2>/dev/null; then
        _hianime_ep_id="$(printf '%s\n' "$1" | awk -F '\t' -v n="$2" 'NR == n { print $1; exit }')"
    fi
    [ -n "$_hianime_ep_id" ] || return 1
    printf '%s' "$_hianime_ep_id"
}

# print the embed url of the HD-1/ZokoAnime server for an episode id in the current mode
hianime_embed_url() {
    _hianime_servers="$(hianime_curl "${hianime_base}/api/theme/episode/servers?episodeId=${1}" -A "$hianime_agent" -H "Accept: application/json" --max-time 20)"
    _hianime_status=$?
    if [ -z "$_hianime_servers" ]; then
        [ "$_hianime_status" -eq 2 ] && return 2
        return 1
    fi

    _hianime_type="sub"
    [ "$mode" = "dub" ] && _hianime_type="dub"
    # HD-2 serves a different player that hianime_deobfuscate cannot read, so it is skipped
    _hianime_hash="$(printf '%s' "$_hianime_servers" |
        sed 's|\\"|"|g;s|server-item|\nserver-item|g' |
        sed -nE 's#.*data-type="'"$_hianime_type"'".*data-server-name="(HD-1|ZokoAnime)".*data-hash="([^"]*)".*#\2#p' |
        head -n 1)"
    [ -n "$_hianime_hash" ] || return 1
    hianime_b64_decode "$_hianime_hash"
}

# print the master playlist url on line 1 and the preferred subtitle url on line 2
hianime_media_fields() {
    _hianime_config="$1"
    _hianime_python="$(ani_watch_python || true)"
    if [ -n "$_hianime_python" ]; then
        printf '%s' "$_hianime_config" | "$_hianime_python" -c '
import json
import sys

try:
    payload = json.load(sys.stdin)
except Exception:
    raise SystemExit(1)
if not isinstance(payload, dict):
    raise SystemExit(1)

source = payload.get("src")
if not isinstance(source, str) or ".m3u8" not in source:
    raise SystemExit(1)

default_tracks = []
english_tracks = []
other_tracks = []
tracks = payload.get("subtitles")
if isinstance(tracks, list):
    for track in tracks:
        if not isinstance(track, dict):
            continue
        url = track.get("src")
        if not isinstance(url, str) or ".vtt" not in url:
            continue
        label = str(track.get("label") or "").casefold()
        language = str(track.get("lang") or "").casefold()
        if track.get("default"):
            default_tracks.append(url)
        elif label.startswith("english") or language.startswith("en"):
            english_tracks.append(url)
        else:
            other_tracks.append(url)

subtitle = ""
for group in (default_tracks, english_tracks, other_tracks):
    if group:
        subtitle = group[0]
        break

print(source)
print(subtitle)
' 2>/dev/null && return 0
    fi

    _hianime_source="$(printf '%s' "$_hianime_config" | sed -nE 's|.*"src":"([^"]*\.m3u8[^"]*)".*|\1|p' | head -n 1 | sed 's|\\/|/|g')"
    [ -n "$_hianime_source" ] || return 1
    printf '%s\n' "$_hianime_source"
    printf '%s' "$_hianime_config" |
        sed -nE 's|.*"subtitles":\[\{[^}]*"src":"([^"]*\.vtt[^"]*)".*|\1|p' |
        head -n 1 |
        sed 's|\\/|/|g'
}

# resolve $ep_no of $1 on hianime.at, print its quality links and set hianime_refr/hianime_sub_link
hianime_fetch_episode_links() {
    _hianime_want_title="${1:-$title}"
    [ -n "$_hianime_want_title" ] || _hianime_want_title="$allanime_title"
    [ -n "$_hianime_want_title" ] || return 1

    _hianime_show="$(hianime_resolve_id "$_hianime_want_title")"
    _hianime_status=$?
    if [ -z "$_hianime_show" ]; then
        if [ "$_hianime_status" -eq 2 ]; then
            hianime_last_error="hianime.at returned a Cloudflare browser challenge"
        else
            hianime_last_error="hianime.at did not return a matching anime"
        fi
        return 1
    fi

    _hianime_ep_list="$(hianime_episodes "$_hianime_show")"
    _hianime_status=$?
    if [ -z "$_hianime_ep_list" ]; then
        if [ "$_hianime_status" -eq 2 ]; then
            hianime_last_error="hianime.at returned a Cloudflare browser challenge"
        else
            hianime_last_error="hianime.at did not return episodes for ${_hianime_want_title}"
        fi
        return 1
    fi

    _hianime_episode="$(hianime_episode_id "$_hianime_ep_list" "$ep_no" || true)"
    if [ -z "$_hianime_episode" ]; then
        hianime_last_error="hianime.at did not expose episode ${ep_no} for ${_hianime_want_title}"
        return 1
    fi

    _hianime_embed="$(hianime_embed_url "$_hianime_episode")"
    _hianime_status=$?
    if [ -z "$_hianime_embed" ]; then
        if [ "$_hianime_status" -eq 2 ]; then
            hianime_last_error="hianime.at returned a Cloudflare browser challenge"
        else
            hianime_last_error="hianime.at returned no ${mode} server for episode ${ep_no}"
        fi
        return 1
    fi

    # the stream host rejects requests that do not carry the embed site as referer
    hianime_refr="$(printf '%s' "$_hianime_embed" | sed -E 's|^(https?://[^/]*).*|\1/|')"

    _hianime_embed_page="$(hianime_curl "$_hianime_embed" -A "$hianime_agent" -H "Referer: ${hianime_base}/" --max-time 20)"
    _hianime_status=$?
    _hianime_blob="$(printf '%s' "$_hianime_embed_page" | sed -nE 's|.*window\.__P="([^"]*)".*|\1|p' | head -n 1)"
    if [ -z "$_hianime_blob" ]; then
        if [ "$_hianime_status" -eq 2 ]; then
            hianime_last_error="hianime.at returned a Cloudflare browser challenge"
        else
            hianime_last_error="hianime.at embed did not expose a player config"
        fi
        return 1
    fi

    _hianime_media="$(hianime_media_fields "$(hianime_deobfuscate "$_hianime_blob")" || true)"
    _hianime_master="$(printf '%s\n' "$_hianime_media" | sed -n '1p')"
    hianime_sub_link="$(printf '%s\n' "$_hianime_media" | sed -n '2p')"
    if [ -z "$_hianime_master" ]; then
        hianime_last_error="hianime.at embed did not expose an HLS playlist"
        return 1
    fi

    _hianime_playlist="$(hianime_curl "$_hianime_master" -A "$hianime_agent" -H "Referer: $hianime_refr" --max-time 20)"
    _hianime_status=$?
    if ! printf '%s' "$_hianime_playlist" | grep -q "EXTM3U"; then
        if [ "$_hianime_status" -eq 2 ]; then
            hianime_last_error="hianime.at returned a Cloudflare browser challenge"
        else
            hianime_last_error="hianime.at playlist was not valid HLS"
        fi
        return 1
    fi

    hls_playlist_links "$_hianime_master" "$_hianime_playlist"
}

ani_watch_python() {
    if [ -n "${ANI_CLI_PYTHON:-}" ] && [ -x "$ANI_CLI_PYTHON" ]; then
        printf '%s' "$ANI_CLI_PYTHON"
