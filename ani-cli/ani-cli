    printf '%s' "$_cache_home/ani-watchlist/allanime-crypto.conf"
}

load_allanime_crypto_cache() {
    _cache_file="$(allanime_crypto_cache_file || true)"
    [ -n "$_cache_file" ] && [ -r "$_cache_file" ] || return 0
    _cache_lane=""
    _cache_derived_key=""

    while IFS='=' read -r _cache_key _cache_value; do
        case "$_cache_key" in
            key_a)
                printf '%s' "$_cache_value" | grep -Eq '^[0-9a-f]{64}$' && allanime_key_a=$_cache_value
                ;;
            key_b)
                [ -n "$_cache_value" ] && allanime_key_b=$_cache_value
                ;;
            epoch)
                case "$_cache_value" in
                    '' | *[!0-9]*) ;;
                    *) allanime_aa_epoch=$_cache_value ;;
                esac
                ;;
            build_id)
                [ -n "$_cache_value" ] && allanime_build_id=$_cache_value
                ;;
            lane)
                [ -n "$_cache_value" ] && _cache_lane=$_cache_value
                ;;
            derived_key)
                printf '%s' "$_cache_value" | grep -Eq '^[0-9a-f]{64}$' && _cache_derived_key=$_cache_value
                ;;
        esac
    done <"$_cache_file"
    [ -n "$_cache_lane" ] && allanime_lane=$_cache_lane

    _derived_key="$(derive_allanime_key_hex "$allanime_key_a" "$allanime_key_b" || true)"
    if [ -n "$_cache_lane" ] && printf '%s' "$_cache_derived_key" | grep -Eq '^[0-9a-f]{64}$'; then
        allanime_key=$_cache_derived_key
        allanime_crypto_cache_loaded=1
    elif [ -n "$_cache_lane" ] && printf '%s' "$_derived_key" | grep -Eq '^[0-9a-f]{64}$'; then
        allanime_key=$_derived_key
        allanime_crypto_cache_loaded=1
    fi
}

save_allanime_crypto_cache() {
    _cache_file="$(allanime_crypto_cache_file || true)"
    [ -n "$_cache_file" ] || return 0
    _cache_dir=${_cache_file%/*}
    mkdir -p "$_cache_dir" 2>/dev/null || return 0
    _derived_key=$allanime_key
    if ! printf '%s' "$_derived_key" | grep -Eq '^[0-9a-f]{64}$'; then
        _derived_key="$(derive_allanime_key_hex "$allanime_key_a" "$allanime_key_b" || true)"
    fi
    printf '%s' "$_derived_key" | grep -Eq '^[0-9a-f]{64}$' || return 0
    _tmp_file="${_cache_file}.$$"
    if {
        printf 'key_a=%s\n' "$allanime_key_a"
        printf 'key_b=%s\n' "$allanime_key_b"
        printf 'epoch=%s\n' "$allanime_aa_epoch"
        printf 'build_id=%s\n' "$allanime_build_id"
        printf 'lane=%s\n' "$allanime_lane"
        printf 'derived_key=%s\n' "$_derived_key"
    } >"$_tmp_file" 2>/dev/null && mv "$_tmp_file" "$_cache_file" 2>/dev/null; then
        :
    else
        rm -f "$_tmp_file"
    fi
}

