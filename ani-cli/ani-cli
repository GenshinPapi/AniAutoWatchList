    _epoch=$((_now_ms / 259200000))
    if [ "$((_now_ms - _epoch * 259200000))" -lt 86400000 ] && [ "$_epoch" -gt 0 ]; then
        _epoch=$((_epoch - 1))
    fi
    printf '%s' "$_epoch"
}

generate_allanime_mask() {
    [ -n "$allanime_build_id" ] || return 1
    _mask_hex=""
    _mask_block=0
    for _mask_part in 10d13/213hI= XdTA6FaAQSo= KRCUT9lZh1o= Aj3ASCIDMnw=; do
        _mask_byte=0
        for _embedded_byte in $(printf '%s' "$_mask_part" | base64 -d 2>/dev/null | od -An -tu1 -v); do
            _mask_index=$((_mask_block * 8 + _mask_byte))
            _char_pos=$((_mask_index % ${#allanime_build_id} + 1))
            _build_char="$(printf '%s' "$allanime_build_id" | cut -c"$_char_pos")"
            _ascii="$(LC_CTYPE=C printf '%s' "$_build_char" | od -An -tu1 | tr -d '[:space:]')"
            [ -n "$_ascii" ] || return 1
            _build_mask_byte=$((_ascii ^ (((_mask_index * 17) + 31) & 255)))
            _tweak=$((((_mask_block * 41) + (_mask_byte * 7)) & 255))
            _value=$((_embedded_byte ^ _build_mask_byte ^ _tweak))
            _mask_hex="${_mask_hex}$(printf '%02x' "$_value")"
