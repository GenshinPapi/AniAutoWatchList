# UI

external_menu() {
    [ "$use_external_menu" = "1" ] && rofi "$1" -sort -dmenu -i -width 1500 -p "$2" "$3"
    [ "$use_external_menu" = "2" ] && dmenu -l 20 -p "$2"
}

launcher() {
    [ "$use_external_menu" = "0" ] && [ -z "$1" ] && set -- "+m" "$2"
    [ "$use_external_menu" = "0" ] && fzf "$1" --reverse --cycle --prompt "$2"
    [ "$use_external_menu" = "1" ] && external_menu "$1" "$2" "$external_menu_args"
    [ "$use_external_menu" = "2" ] && external_menu "$1" "$2"
}

nth() {
    stdin=$(cat -)
    [ -z "$stdin" ] && return 1
    line_count="$(printf "%s\n" "$stdin" | wc -l | tr -d "[:space:]")"
    [ "$line_count" -eq 1 ] && printf "%s" "$stdin" | cut -f2,3 && return 0
    prompt="$1"
    multi_flag=""
    [ $# -ne 1 ] && shift && multi_flag="$1"
    line=$(printf "%s" "$stdin" | cut -f1,3 | tr '\t' ' ' | launcher "$multi_flag" "$prompt" | cut -d " " -f 1)
    line_start=$(printf "%s" "$line" | head -n1)
    line_end=$(printf "%s" "$line" | tail -n1)
    [ -n "$line" ] || exit 1
    if [ "$line_start" = "$line_end" ]; then
        printf "%s" "$stdin" | grep -E '^'"${line}"'($|[[:space:]])' | cut -f2,3 || exit 1
    else
        printf "%s" "$stdin" | sed -n '/^'"${line_start}"'$/,/^'"${line_end}$"'/p' || exit 1
    fi
}

die() {
    printf "\33[2K\r\033[1;31m%s\033[0m\n" "$*" >&2
    exit 1
}

ani_watch_hook() {
    [ "${ANI_WATCH_DISABLE:-0}" = "1" ] && return 0
    command -v ani-watch-hook >/dev/null 2>&1 || return 0
    ani-watch-hook "$@" >/dev/null 2>&1 || true
}

ani_watch_open_gui() {
    [ "${ANI_WATCH_OPEN_GUI:-0}" = "1" ] || return 0
    command -v ani-watch-gui >/dev/null 2>&1 || return 0
    nohup ani-watch-gui >/dev/null 2>&1 &
}

ani_watch_json_array() {
    command -v python3 >/dev/null 2>&1 || {
        printf "[]"
        return 0
    }
    python3 -c 'import json, sys; print(json.dumps(sys.argv[1:]))' "$@"
}

ani_watch_ep_list_json() {
    command -v python3 >/dev/null 2>&1 || {
        printf "[]"
        return 0
    }
    printf "%s\n" "$1" | python3 -c 'import json, sys; print(json.dumps([line.strip() for line in sys.stdin if line.strip()]))'
}

ani_watch_playback_started() {
    ani_watch_hook playback-started --title "$title" --source-title "$title" --episode "$ep_no"
}

ani_watch_playback_finished() {
    ani_watch_exit_code=$1
    ani_watch_started_at=$2
    ani_watch_finished_at=$(date +%s)
    ani_watch_duration=$((ani_watch_finished_at - ani_watch_started_at))
    ani_watch_hook playback-finished --title "$title" --source-title "$title" --episode "$ep_no" --exit-code "$ani_watch_exit_code" --duration-seconds "$ani_watch_duration"
}

ani_watch_run_foreground() {
    ani_watch_started_at=$(date +%s)
    ani_watch_playback_started
    "$@"
    ani_watch_exit_code=$?
    ani_watch_playback_finished "$ani_watch_exit_code" "$ani_watch_started_at"
    return "$ani_watch_exit_code"
}

ani_watch_run_detached() {
    # shellcheck disable=SC2016
    nohup sh -c '
        ani_watch_title=$1
        ani_watch_episode=$2
        shift 2
        ani_watch_started_at=$(date +%s)
        if command -v ani-watch-hook >/dev/null 2>&1; then
            ani-watch-hook playback-started --title "$ani_watch_title" --source-title "$ani_watch_title" --episode "$ani_watch_episode" >/dev/null 2>&1 || true
        fi
        "$@"
        ani_watch_exit_code=$?
        ani_watch_finished_at=$(date +%s)
        ani_watch_duration=$((ani_watch_finished_at - ani_watch_started_at))
        if command -v ani-watch-hook >/dev/null 2>&1; then
            ani-watch-hook playback-finished --title "$ani_watch_title" --source-title "$ani_watch_title" --episode "$ani_watch_episode" --exit-code "$ani_watch_exit_code" --duration-seconds "$ani_watch_duration" >/dev/null 2>&1 || true
        fi
        exit "$ani_watch_exit_code"
    ' ani-watch-player "$title" "$ep_no" "$@" >/dev/null 2>&1 &
}

