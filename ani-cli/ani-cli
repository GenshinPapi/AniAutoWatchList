    hex_to_bytes16 "$2"
    _xor_i=0
    while [ "$_xor_i" -lt 16 ]; do
        eval "b$_xor_i=\$((b$_xor_i ^ xa$_xor_i))"
        _xor_i=$((_xor_i + 1))
    done
    bytes16_to_hex
