# resolves the requested episode through anidb.app and selects the desired quality into $episode
anidb_select_episode_url() {
    unset episode links subtitle subs_flag refr_flag m3u8_refr result
    anidb_last_error=""

    anidb_links_file="$(mktemp)"
    anidb_fetch_episode_links "$title" >"$anidb_links_file" || true
    links="$(cat "$anidb_links_file")"
    rm -f "$anidb_links_file"
    [ -n "$links" ] || return 1

    links="$(prefer_playable_links "$links")"
    select_quality "$quality"
    if [ -z "$episode" ]; then
        anidb_last_error="anidb.app returned streams, but no playable quality matched"
        return 1
    fi
    refr_flag="--referrer=https://anidb.app"
    m3u8_refr="https://anidb.app"
    printf "\033[1;32m%s\033[0m Links Fetched\n" "anidb.app" 1>&2
    return 0
}

# resolves the requested episode through hianime.at and selects the desired quality into $episode
hianime_select_episode_url() {
    unset episode links subtitle subs_flag refr_flag m3u8_refr result
    hianime_last_error=""
    hianime_refr=""
    hianime_sub_link=""

    hianime_links_file="$(mktemp)"
    hianime_fetch_episode_links "$title" >"$hianime_links_file" || true
    links="$(cat "$hianime_links_file")"
    rm -f "$hianime_links_file"
    [ -n "$links" ] || return 1

    select_quality "$quality"
    if [ -z "$episode" ]; then
        hianime_last_error="hianime.at returned streams, but no playable quality matched"
        return 1
    fi
    if [ -n "$hianime_refr" ]; then
        refr_flag="--referrer=$hianime_refr"
        m3u8_refr="$hianime_refr"
    fi
    # hianime does not burn subtitles into the video, so the external track has to be handed to the player
    if [ -n "$hianime_sub_link" ]; then
        subtitle="$hianime_sub_link"
        subs_flag="--sub-file=$hianime_sub_link"
    fi
    printf "\033[1;32m%s\033[0m Links Fetched\n" "hianime.at" 1>&2
    return 0
}

# tries anidb.app first and falls back to hianime.at so a single provider outage is not fatal
get_episode_url() {
    unset episode links subtitle subs_flag refr_flag m3u8_refr result
    anidb_last_error=""
    hianime_last_error=""

    printf "%s" "$ep_list" | grep -q "^$ep_no$" || die "Episode not released!"

    if [ "$anidb_enabled" = "1" ]; then
        anidb_select_episode_url && return 0
        [ -n "$anidb_last_error" ] || anidb_last_error="no playable sources returned"
        if [ "$hianime_enabled" = "1" ]; then
            printf "\33[2K\r\033[1;33m%s\033[0m\n" "anidb.app playback failed: ${anidb_last_error}. Trying hianime.at..." 1>&2
        fi
    fi

    if [ "$hianime_enabled" = "1" ]; then
        hianime_select_episode_url && return 0
        [ -n "$hianime_last_error" ] || hianime_last_error="no playable sources returned"
    fi

    if [ -n "$anidb_last_error" ] && [ -n "$hianime_last_error" ]; then
        die "Playback failed. anidb.app: ${anidb_last_error}. hianime.at: ${hianime_last_error}."
    fi
    [ -n "$anidb_last_error" ] && die "anidb.app playback failed: ${anidb_last_error}."
    [ -n "$hianime_last_error" ] && die "hianime.at playback failed: ${hianime_last_error}."
    die "Playback failed: no playback provider is enabled."
}

# search the query and give results
search_anime() {
    #shellcheck disable=SC2016
    search_gql='query( $search: SearchInput $limit: Int $page: Int $translationType: VaildTranslationTypeEnumType $countryOrigin: VaildCountryOriginEnumType ) { shows( search: $search limit: $limit page: $page translationType: $translationType countryOrigin: $countryOrigin ) { edges { _id name englishName nativeName availableEpisodes __typename } }}'

    search_resp=$(curl -e "$allanime_api_refr" -s -H "Content-Type: application/json" -H "Origin: ${allanime_api_refr}" -X POST "${allanime_api}/api" --data "{\"variables\":{\"search\":{\"allowAdult\":true,\"allowUnknown\":true,\"query\":\"$1\"},\"limit\":40,\"page\":1,\"translationType\":\"$mode\",\"countryOrigin\":\"ALL\"},\"query\":\"$search_gql\"}" -A "$agent")
    if command -v python3 >/dev/null 2>&1; then
        printf '%s' "$search_resp" | python3 -c '
import json
import re
import sys
import urllib.parse

mode = sys.argv[1]
query = urllib.parse.unquote_plus(sys.argv[2]) if len(sys.argv) > 2 else ""

def normalized(value):
    value = (value or "").casefold()
    value = re.sub(r"[^a-z0-9]+", " ", value)
    return " ".join(value.split())

query_norm = normalized(query)
query_terms = set(query_norm.split())

def episode_count(item):
    episodes = (item.get("availableEpisodes") or {}).get(mode)
    try:
        return int(episodes)
    except (TypeError, ValueError):
        return 0

def title_score(item, original_index):
    titles = [
        (item.get("name") or "").strip(),
        (item.get("englishName") or "").strip(),
        (item.get("nativeName") or "").strip(),
    ]
    title_norms = [normalized(title) for title in titles if title]
    if not query_norm or not title_norms:
        return (9, 9, -episode_count(item), original_index)

    if any(title == query_norm for title in title_norms):
        return (0, 0, -episode_count(item), original_index)

    penalties = []
    ranks = []
    for title in title_norms:
        if title.startswith(f"{query_norm} "):
            ranks.append(1)
        elif query_norm in title:
            ranks.append(2)
        elif query_terms and query_terms.issubset(set(title.split())):
            ranks.append(3)
        else:
            continue

        special = bool(re.search(r"\b(season|part|movie|special|ova|ona|mini|recap|pv)\b", title))
        penalties.append(1 if special else 0)

    if not ranks:
        return (8, 8, -episode_count(item), original_index)
    return (min(ranks), min(penalties or [0]), -episode_count(item), original_index)

try:
    edges = (((json.load(sys.stdin).get("data") or {}).get("shows") or {}).get("edges") or [])
except Exception:
    edges = []
ranked_edges = sorted(enumerate(edges), key=lambda pair: title_score(pair[1], pair[0]))
for _index, item in ranked_edges:
    episodes = episode_count(item)
    if episodes <= 0:
        continue
    name = (item.get("name") or "").strip()
    english = (item.get("englishName") or "").strip()
    if english and name and english.casefold() != name.casefold():
        title = f"{english} ({name})"
    else:
        title = english or name
    show_id = item.get("_id")
    if show_id and title:
        print(f"{show_id}\t{title} ({episodes} episodes)")
' "$mode" "$1"
    else
        printf '%s' "$search_resp" | sed 's|Show|\
| g' | sed -nE "s|.*_id\":\"([^\"]*)\",\"name\":\"(.+)\",.*${mode}\":([1-9][^,]*).*|\1	\2 (\3 episodes)|p" | sed 's/\\"//g'
    fi
}

time_until_next_ep() {
    animeschedule="https://animeschedule.net"
    query="$(printf "%s\n" "$*" | tr ' ' '+')"
    curl -s -G "$animeschedule/api/v3/anime" --data "q=${query}" | sed 's|"id"|\n|g' | sed -nE 's|.*,"route":"([^"]*)","premier.*|\1|p' | while read -r anime; do
        data=$(curl -s "$animeschedule/anime/$anime" | sed '1,/"anime-header-list-buttons-wrapper"/d' | sed -nE 's|.*countdown-time-raw" datetime="([^"]*)">.*|Next Raw Release: \1|p;s|.*countdown-time" datetime="([^"]*)">.*|Next Sub Release: \1|p;s|.*english-title">([^<]*)<.*|English Title: \1|p;s|.*main-title".*>([^<]*)<.*|Japanese Title: \1|p')
        status="Ongoing"
        color="33"
        printf "%s\n" "$data"
        ! (printf "%s\n" "$data" | grep -q "Next Raw Release:") && status="Finished" && color="32"
        printf "Status:  \033[1;%sm%s\033[0m\n---\n" "$color" "$status"
    done
    exit 0
}

# get the episodes list of the selected anime
episodes_list() {
    #shellcheck disable=SC2016
    episodes_list_gql='query ($showId: String!) { show( _id: $showId ) { _id availableEpisodesDetail }}'

    curl -e "$allanime_api_refr" -s -H "Content-Type: application/json" -H "Origin: ${allanime_api_refr}" -X POST "${allanime_api}/api" --data "{\"variables\":{\"showId\":\"$*\"},\"query\":\"$episodes_list_gql\"}" -A "$agent" | sed -nE "s|.*$mode\":\[([0-9.\",]*)\].*|\1|p" | sed 's|,|\
|g; s|"||g' | sort -n -k 1
}

# PLAYING

process_hist_entry() {
    ep_list=$(episodes_list "$id")
    latest_ep=$(printf "%s\n" "$ep_list" | tail -n1)
    title=$(printf "%s\n" "$title" | sed "s|[0-9]\+ episodes|${latest_ep} episodes|")
    ep_no=$(printf "%s" "$ep_list" | sed -n "/^${ep_no}$/{n;p;}") 2>/dev/null
    [ -n "$ep_no" ] && printf "%s\t%s - episode %s\n" "$id" "$title" "$ep_no"
}

update_history() {
    if grep -q -- "$id" "$histfile"; then
        sed -E "s|^[^	]+	${id}	[^	]+$|${ep_no}	${id}	${title}|" "$histfile" >"${histfile}.new"
    else
        cp "$histfile" "${histfile}.new"
        printf "%s\t%s\t%s\n" "$ep_no" "$id" "$title" >>"${histfile}.new"
    fi
    mv "${histfile}.new" "$histfile"
}

download() {
    # download subtitle if it's set
    [ -n "$subtitle" ] && curl -s "$subtitle" -o "$download_dir/$2.vtt"
    case $1 in
        *m3u8*)
            if command -v "yt-dlp" >/dev/null; then
                yt-dlp --referer "$m3u8_refr" "$1" --no-skip-unavailable-fragments --fragment-retries infinite -N 16 -o "$download_dir/$2.mp4"
            else
                ffmpeg -extension_picky 0 -referer "$m3u8_refr" -loglevel error -stats -i "$1" -c copy "$download_dir/$2.mp4"
            fi
            # embed subs into downloads
            # [ -e "$download_dir/$2.vtt" ] && ffmpeg -i "$download_dir/$2.mp4" -i "$download_dir/$2.vtt" -c copy -c:s mov_text "$download_dir/$2.bak.mp4" && mv "$download_dir/$2.bak.mp4" "$download_dir/$2.mp4"
            ;;
        *)
            download_refr="${refr_flag#--referrer=}"
            [ "$download_refr" = "$refr_flag" ] && download_refr="$allanime_refr"
            # shellcheck disable=SC2086
            aria2c --referer="$download_refr" --enable-rpc=false --check-certificate=false --continue $iSH_DownFix --summary-interval=0 -x 16 -s 16 "$1" --dir="$download_dir" -o "$2.mp4" --download-result=hide
            ;;
    esac
}

play_episode() {
    [ "$log_episode" = 1 ] && [ "$player_function" != "debug" ] && [ "$player_function" != "download" ] && command -v logger >/dev/null && logger -t ani-cli "${allanime_title}${ep_no}"
    [ "$skip_intro" = 1 ] && skip_flag="$(ani-skip -q "$mal_id" -e "$ep_no")"
    unset ipc_flag wid_flag mpv_extra_flags
    [ -n "${ANI_WATCH_MPV_IPC:-}" ] && ipc_flag="--input-ipc-server=$ANI_WATCH_MPV_IPC"
    [ -n "${ANI_WATCH_MPV_WID:-}" ] && wid_flag="--wid=$ANI_WATCH_MPV_WID"
    [ -n "${ANI_WATCH_MPV_EXTRA_ARGS:-}" ] && mpv_extra_flags="$ANI_WATCH_MPV_EXTRA_ARGS"
    [ -z "$episode" ] && get_episode_url
    # shellcheck disable=SC2086
    case "$player_function" in
        debug)
            printf "All links:\n%s\nSelected link:\n" "$links"
            printf "%s\n" "$episode"
            ;;
        mpv*)
            if [ "$no_detach" = 0 ]; then
                ani_watch_run_detached $player_function $skip_flag $ipc_flag $wid_flag $mpv_extra_flags --force-media-title="${allanime_title}Episode ${ep_no}" "$episode" $subs_flag $refr_flag
            else
                ani_watch_run_foreground $player_function $skip_flag $ipc_flag $wid_flag $mpv_extra_flags $subs_flag $refr_flag --force-media-title="${allanime_title}Episode ${ep_no}" "$episode"
                mpv_exitcode=$?
                [ "$exit_after_play" = 1 ] && [ -z "$range" ] && exit "$mpv_exitcode"
            fi
            ;;
        android_mpv) ani_watch_run_detached am start --user 0 -a android.intent.action.VIEW -d "$episode" -n is.xyz.mpv/.MPVActivity ;;
        android_vlc) ani_watch_run_detached am start --user 0 -a android.intent.action.VIEW -d "$episode" -n org.videolan.vlc/org.videolan.vlc.gui.video.VideoPlayerActivity -e "title" "${allanime_title}Episode ${ep_no}" ;;
        *iina*)
            [ -n "$subs_flag" ] && subs_flag="--mpv-${subs_flag#--}"
            [ -n "$refr_flag" ] && refr_flag="--mpv-${refr_flag#--}"
            if pgrep -f "IINA" >/dev/null 2>&1; then
                # omit --keep-running when an IINA instance exists to prevent hanging
                ani_watch_run_detached $player_function --no-stdin --mpv-force-media-title="${allanime_title}Episode ${ep_no}" $subs_flag $refr_flag "$episode"
            else
                ani_watch_run_detached $player_function --no-stdin --keep-running --mpv-force-media-title="${allanime_title}Episode ${ep_no}" $subs_flag $refr_flag "$episode"
            fi
            ;;
        flatpak_mpv) ani_watch_run_detached flatpak run io.mpv.Mpv $ipc_flag $wid_flag $mpv_extra_flags --force-media-title="${allanime_title}Episode ${ep_no}" "$episode" $subs_flag $refr_flag ;;
        vlc*)
            vlc_refr="${refr_flag#--referrer=}"
            [ "$vlc_refr" = "$refr_flag" ] && vlc_refr="$allanime_refr"
            # vlc rewrites --sub-file into a local path, so an external subtitle url rides along as an MRL option
            unset vlc_subs_flag
            [ -n "$subtitle" ] && vlc_subs_flag=":input-slave=$subtitle"
            ani_watch_run_detached $player_function --http-referrer="$vlc_refr" --play-and-exit --meta-title="${allanime_title}Episode ${ep_no}" "$episode" $vlc_subs_flag
            ;;
        *yncpla*) ani_watch_run_detached $player_function "$episode" -- --force-media-title="${allanime_title}Episode ${ep_no}" $subs_flag $refr_flag ;;
        download) ani_watch_run_foreground "$player_function" "$episode" "${allanime_title}Episode ${ep_no}" "$subtitle" ;;
        catt) ani_watch_run_detached catt cast "$episode" -s "$subtitle" ;;
        iSH)
            ani_watch_ish_started_at=$(date +%s)
            ani_watch_playback_started
            printf "\e]8;;vlc://%s\a~~~~~~~~~~~~~~~~~~~~\n~ Tap to open VLC ~\n~~~~~~~~~~~~~~~~~~~~\e]8;;\a\n" "$episode"
            sleep 5
            ani_watch_playback_finished 0 "$ani_watch_ish_started_at"
            ;;
        *) ani_watch_run_detached $player_function "$episode" ;;
    esac
    replay="$episode"
    unset episode
    update_history
    [ "$use_external_menu" = "1" ] && wait
    [ "$use_external_menu" = "2" ] && wait
}

play() {
    start=$(printf "%s" "$ep_no" | grep -Eo '^(-1|[0-9]+(\.[0-9]+)?)')
    end=$(printf "%s" "$ep_no" | grep -Eo '(-1|[0-9]+(\.[0-9]+)?)$')
    [ "$start" = "-1" ] && ep_no=$(printf "%s" "$ep_list" | tail -n1) && unset start
    [ -z "$end" ] || [ "$end" = "$start" ] && unset start end
    [ "$end" = "-1" ] && end=$(printf "%s" "$ep_list" | tail -n1)
    line_count=$(printf "%s\n" "$ep_no" | wc -l | tr -d "[:space:]")
    if [ "$line_count" != 1 ] || [ -n "$start" ]; then
        [ -z "$start" ] && start=$(printf "%s\n" "$ep_no" | head -n1)
        [ -z "$end" ] && end=$(printf "%s\n" "$ep_no" | tail -n1)
        range=$(printf "%s\n" "$ep_list" | sed -nE "/^${start}\$/,/^${end}\$/p")
        [ -z "$range" ] && die "Invalid range!"
        for i in $range; do
            tput clear
            ep_no=$i
            printf "\33[2K\r\033[1;34mPlaying episode %s...\033[0m\n" "$ep_no"
            [ "$i" = "$end" ] && unset range
            play_episode
        done
    else
        play_episode
    fi
    # moves up to stored position and deletes to end
    [ "$player_function" != "debug" ] && [ "$player_function" != "download" ] && tput rc && tput ed
}

# MAIN

# setup
agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:150.0) Gecko/20100101 Firefox/150.0"
scraper_agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
anidb_agent="$scraper_agent"
hianime_agent="$scraper_agent"
hianime_base="${ANI_CLI_HIANIME_BASE:-https://hianime.at}"
anidb_enabled="${ANI_CLI_ANIDB:-1}"
hianime_enabled="${ANI_CLI_HIANIME:-1}"
allanime_refr="https://youtu-chan.com"
allanime_api_refr="https://mkissa.to"
allanime_api="https://api.mkissa.net"
mode="${ANI_CLI_MODE:-sub}"
download_dir="${ANI_CLI_DOWNLOAD_DIR:-.}"
log_episode="${ANI_CLI_LOG:-1}"
quality="${ANI_CLI_QUALITY:-best}"
case "$(uname -a | cut -d " " -f 1,3-)" in
    *Darwin*) player_function="${ANI_CLI_PLAYER:-$(where_iina)}" ;;   # mac OS
    *ndroid*) player_function="${ANI_CLI_PLAYER:-android_mpv}" ;;     # Android OS (termux)
    *MINGW* | *WSL2*) player_function="${ANI_CLI_PLAYER:-mpv.exe}" ;; # Windows OS
    *ish*) player_function="${ANI_CLI_PLAYER:-iSH}" ;;                # iOS (iSH)
    *) player_function="${ANI_CLI_PLAYER:-$(where_mpv)}" ;;           # Linux OS
esac

no_detach="${ANI_CLI_NO_DETACH:-0}"
exit_after_play="${ANI_CLI_EXIT_AFTER_PLAY:-0}"
use_external_menu="${ANI_CLI_EXTERNAL_MENU:-0}"
external_menu_normal_window="${ANI_CLI_EXTERNAL_MENU_NORMAL_WINDOW:-0}"
skip_intro="${ANI_CLI_SKIP_INTRO:-0}"
skip_title="${ANI_CLI_SKIP_TITLE:-}"
[ -t 0 ] || (command -v dmenu && use_external_menu=2)
[ -t 0 ] || (command -v rofi && use_external_menu=1)
hist_dir="${ANI_CLI_HIST_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/ani-cli}"
[ ! -d "$hist_dir" ] && mkdir -p "$hist_dir"
histfile="$hist_dir/ani-hsts"
[ ! -f "$histfile" ] && : >"$histfile"
search="${ANI_CLI_DEFAULT_SOURCE:-scrape}"
ani_watch_hook launch --argv-json "$(ani_watch_json_array "$0" "$@")"
ani_watch_open_gui

while [ $# -gt 0 ]; do
    case "$1" in
        -v | --vlc)
            case "$(uname -a | cut -d " " -f 1,3-)" in
                *ndroid*) player_function="android_vlc" ;;
                MINGW* | *WSL2*) player_function="vlc.exe" ;;
                *ish*) player_function="iSH" ;;
                *) player_function="vlc" ;;
            esac
            ;;
        -s | --syncplay)
            case "$(uname -s)" in
                Darwin*) player_function="/Applications/Syncplay.app/Contents/MacOS/syncplay" ;;
                MINGW* | *Msys)
                    export PATH="$PATH":"/c/Program Files (x86)/Syncplay/"
                    player_function="syncplay.exe"
                    ;;
                *) player_function="syncplay" ;;
            esac
            ;;
        -q | --quality)
            [ $# -lt 2 ] && die "missing argument!"
            quality="$2"
            shift
            ;;
        -S | --select-nth)
            [ $# -lt 2 ] && die "missing argument!"
            index="$2"
            shift
            ;;
        -c | --continue) search=history ;;
        -d | --download)
            [ "$player_function" = "iSH" ] && iSH_DownFix="--async-dns=false"
            player_function=download
            ;;
        -D | --delete)
            : >"$histfile"
            exit 0
            ;;
        -l | --logview)
            case "$(uname -s)" in
                Darwin*) log show --predicate 'process == "logger"' ;;
                Linux*) journalctl -t ani-cli ;;
                *) die "Logger not implemented for your platform" ;;
            esac
            exit 0
            ;;
        -V | --version) version_info ;;
        -h | --help) help_info ;;
        -e | --episode | -r | --range)
            [ $# -lt 2 ] && die "missing argument!"
            ep_no="$2"
            shift
            ;;
        --dub) mode="dub" ;;
        --no-detach) no_detach=1 ;;
        --exit-after-play) exit_after_play=1 && no_detach=1 ;;
        --rofi) use_external_menu=1 ;;
        --dmenu) use_external_menu=2 ;;
        --skip) skip_intro=1 ;;
        --skip-title)
            [ $# -lt 2 ] && die "missing argument!"
            skip_title="$2"
            shift
            ;;
        --allanime-id)
            [ $# -lt 2 ] && die "missing argument!"
            allanime_id="$2"
            shift
            ;;
        -N | --nextep-countdown) search=nextep ;;
        -U | --update) update_script ;;
        *) query="$(printf "%s" "$query $1" | sed "s|^ ||;s| |+|g")" ;;
    esac
    shift
done
[ -n "$allanime_id" ] && search=allanime-id
[ "$use_external_menu" = "0" ] && multi_selection_flag="${ANI_CLI_MULTI_SELECTION:-"-m"}"
[ "$use_external_menu" = "1" ] && multi_selection_flag="${ANI_CLI_MULTI_SELECTION:-"-multi-select"}"
[ "$external_menu_normal_window" = "1" ] && external_menu_args="-normal-window"
printf "\33[2K\r\033[1;34mChecking dependencies...\033[0m\n"
dep_ch "curl" "sed" "grep" || true
case "$(uname -o 2>/dev/null)" in
    *ndroid*) command -v openssl >/dev/null || die 'Program "openssl" not found. On Termux, install with: pkg install openssl-tool' ;;
    *) dep_ch "openssl" || true ;;
esac
[ "$skip_intro" = 1 ] && (dep_ch "ani-skip" || true)
dep_ch "fzf" || true
case "$player_function" in
    debug) ;;
    download) dep_ch "ffmpeg" "aria2c" ;;
    android*) printf "\33[2K\rChecking of players on Android is disabled\n" ;;
    *iSH*) printf "\33[2K\rChecking of players on iOS is disabled\n" ;;
    flatpak_mpv) true ;; # handled out of band in where_mpv
    *) dep_ch "$player_function" ;;
esac

# searching
case "$search" in
    allanime-id)
        id="$allanime_id"
        title="$(printf "%s" "$query" | sed 's|+| |g')"
        [ -z "$title" ] && title="$id"
        ep_list=$(episodes_list "$id")
        [ -z "$ep_list" ] && die "No episodes found for AllAnime ID $id"
        allanime_title="$(printf "%s" "$title" | cut -d'(' -f1 | tr -d '[:punct:]')"
        ani_watch_hook title-selected --title "$title" --source-title "$title"
        ani_watch_hook episodes-listed --title "$title" --source-title "$title" --episodes-json "$(ani_watch_ep_list_json "$ep_list")" --source-label "$mode"
        [ -z "$ep_no" ] && ep_no=$(printf "%s" "$ep_list" | nth "Select episode: " "$multi_selection_flag")
        [ -z "$ep_no" ] && exit 1
        ;;
    history)
        anime_list=$(while read -r ep_no id title; do process_hist_entry & done <"$histfile")
        wait
        [ -z "$anime_list" ] && die "No unwatched series in history!"
        [ -z "${index##*[!0-9]*}" ] && id=$(printf "%s" "$anime_list" | nl -w 2 | sed 's/^[[:space:]]//' | nth "Select anime: " | cut -f1)
        [ -z "${index##*[!0-9]*}" ] || id=$(printf "%s" "$anime_list" | sed -n "${index}p" | cut -f1)
        [ -z "$id" ] && exit 1
        title=$(printf "%s" "$anime_list" | grep "$id" | cut -f2 | sed 's/ - episode.*//')
        ep_list=$(episodes_list "$id")
        ep_no=$(printf "%s" "$anime_list" | grep "$id" | cut -f2 | sed -nE 's/.*- episode (.+)$/\1/p')
        allanime_title="$(printf "%s" "$title" | cut -d'(' -f1 | tr -d '[:punct:]')"
        ani_watch_hook title-selected --title "$title" --source-title "$title"
        ani_watch_hook episodes-listed --title "$title" --source-title "$title" --episodes-json "$(ani_watch_ep_list_json "$ep_list")" --source-label "$mode"
        ;;
    *)
        if [ "$use_external_menu" = "0" ]; then
            while [ -z "$query" ]; do
                printf "\33[2K\r\033[1;36mSearch anime: \033[0m" && read -r query
            done
        else
            [ -z "$query" ] && query=$(printf "" | external_menu "" "Search anime: " "$external_menu_args")
            [ -z "$query" ] && exit 1
        fi
        # for checking new releases by specifying anime name
        [ "$search" = "nextep" ] && time_until_next_ep "$query"

        query=$(printf "%s" "$query" | sed "s| |+|g")
        anime_list=$(search_anime "$query")
        [ -z "$anime_list" ] && die "No results found!"
        [ "$index" -eq "$index" ] 2>/dev/null && result=$(printf "%s" "$anime_list" | sed -n "${index}p")
        [ -z "$index" ] && result=$(printf "%s" "$anime_list" | nl -w 2 | sed 's/^[[:space:]]//' | nth "Select anime: ")
        [ -z "$result" ] && exit 1
        title=$(printf "%s" "$result" | cut -f2)
        allanime_title="$(printf "%s" "$title" | cut -d'(' -f1 | tr -d '[:punct:]')"
        id=$(printf "%s" "$result" | cut -f1)
        ani_watch_hook title-selected --title "$title" --source-title "$title"
        ep_list=$(episodes_list "$id")
        ani_watch_hook episodes-listed --title "$title" --source-title "$title" --episodes-json "$(ani_watch_ep_list_json "$ep_list")" --source-label "$mode"
        [ -z "$ep_no" ] && ep_no=$(printf "%s" "$ep_list" | nth "Select episode: " "$multi_selection_flag")
        [ -z "$ep_no" ] && exit 1
        ;;
esac
[ "$skip_intro" = 1 ] && mal_id="$(ani-skip -q "${skip_title:-${title}}")"

# moves the cursor up one line and clears that line
tput cuu1 && tput el
# stores the position of cursor
tput sc

# playback & loop
play
[ "$player_function" = "download" ] || [ "$player_function" = "debug" ] && exit 0

while cmd=$(printf "next\nreplay\nprevious\nselect\nchange_quality\nquit" | nth "Playing episode $ep_no of $title... "); do
    case "$cmd" in
        next) ep_no=$(printf "%s" "$ep_list" | sed -n "/^${ep_no}$/{n;p;}") 2>/dev/null ;;
        replay) episode="$replay" ;;
        previous) ep_no=$(printf "%s" "$ep_list" | sed -n "/^${ep_no}$/{g;1!p;};h") 2>/dev/null ;;
        select) ep_no=$(printf "%s" "$ep_list" | nth "Select episode: " "$multi_selection_flag") ;;
        change_quality)
            new_quality="$(printf "%s" "$links" | launcher | cut -d\> -f1)"
            select_quality "$new_quality"
            ;;
        *) exit 0 ;;
    esac
    [ -z "$ep_no" ] && die "Out of range"
    play
done

