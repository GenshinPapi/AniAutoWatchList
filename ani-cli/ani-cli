            while [ "$_gf_i" -le 15 ]; do
                eval "_gf_cur=\$v$_gf_i"
                eval "v$_gf_i=\$(((_gf_cur >> 1) | (_gf_prev << 7)))"
                _gf_prev=$((_gf_cur & 1))
                _gf_i=$((_gf_i + 1))
            done
            [ "$_gf_lsb" -eq 1 ] && v0=$((v0 ^ 225))
            _gf_bit=$((_gf_bit - 1))
        done
        _gf_byte_i=$((_gf_byte_i + 1))
    done

    _gf_i=0
    while [ "$_gf_i" -lt 16 ]; do
        eval "b$_gf_i=\$z$_gf_i"
        _gf_i=$((_gf_i + 1))
    done
    bytes16_to_hex
}

# shellcheck disable=SC2154
ghash() {
    _ghash_data=$1
    _ghash_y="00000000000000000000000000000000"
    _ghash_blocks=$((${#_ghash_data} / 32))
    _ghash_idx=0
    while [ "$_ghash_idx" -lt "$_ghash_blocks" ]; do
        _ghash_off=$((_ghash_idx * 32 + 1))
        _ghash_block="$(printf '%s' "$_ghash_data" | cut -c"${_ghash_off}-$((_ghash_off + 31))")"
        _ghash_y="$(gf_mult "$(xor_hex16 "$_ghash_y" "$_ghash_block")" "$h_hex")"
        _ghash_idx=$((_ghash_idx + 1))
    done
    printf '%s' "$_ghash_y"
}

make_aa_req_openssl() {
    command -v openssl >/dev/null 2>&1 || return 1
    printf '%s' "$allanime_key" | grep -Eq '^[0-9a-f]{64}$' || return 1
    [ -n "$allanime_lane" ] || return 1

    _query_hash=$1
    _ts="$(($(date +%s) / 300 * 300 * 1000))"
    _payload_iv="${allanime_aa_epoch}:${allanime_build_id}:${_query_hash}:${_ts}:${allanime_lane}"
    _payload="{\"v\":1,\"ts\":$_ts,\"epoch\":$allanime_aa_epoch,\"buildId\":\"$allanime_build_id\",\"qh\":\"$_query_hash\",\"k\":\"$allanime_lane\"}"

    _iv_hex="$(printf '%s' "$_payload_iv" | openssl dgst -sha256 -binary | dd bs=1 count=12 2>/dev/null | od -An -tx1 | tr -d ' \n')"
    _payload_hex="$(printf '%s' "$_payload" | od -An -tx1 | tr -d ' \n')"
    h_hex="$(dd if=/dev/zero bs=16 count=1 2>/dev/null | openssl enc -aes-256-ecb -K "$allanime_key" -nopad -e 2>/dev/null | od -An -tx1 | tr -d ' \n')"
    _ct_hex="$(hex_to_bin "$_payload_hex" | openssl enc -aes-256-ctr -K "$allanime_key" -iv "${_iv_hex}00000002" -e 2>/dev/null | od -An -tx1 | tr -d ' \n')"
    printf '%s' "$_iv_hex$_ct_hex$h_hex" | grep -Eq '^[0-9a-f]+$' || return 1

    _ct_rem=$((${#_ct_hex} % 32))
    if [ "$_ct_rem" -ne 0 ]; then
        _ct_pad=$((32 - _ct_rem))
        _ct_zeros="$(printf '%*s' "$_ct_pad" '' | tr ' ' '0')"
        _ct_padded="${_ct_hex}${_ct_zeros}"
    else
        _ct_padded=$_ct_hex
    fi
    _ct_bits=$((${#_ct_hex} * 8 / 2))
    _len_block="$(printf '0000000000000000%016x' "$_ct_bits")"
    _tag_mask="$(hex_to_bin "${_iv_hex}00000001" | openssl enc -aes-256-ecb -K "$allanime_key" -nopad -e 2>/dev/null | od -An -tx1 | tr -d ' \n')"
    _tag="$(xor_hex16 "$(ghash "${_ct_padded}${_len_block}")" "$_tag_mask")"

    {
        printf '\001'
        hex_to_bin "$_iv_hex"
        hex_to_bin "$_ct_hex"
        hex_to_bin "$_tag"
    } | base64 | tr -d '\n'
}

make_aa_req() {
    _query_hash=$1
    [ -n "$allanime_lane" ] || return 1
    if command -v node >/dev/null 2>&1; then
        # shellcheck disable=SC2016
        node -e '
const crypto = require("crypto");
const qh = process.argv[1] || "";
const epoch = process.argv[2] || "";
const buildId = process.argv[3] || "";
const key = Buffer.from(process.argv[4] || "", "hex");
const lane = process.argv[5] || "";
if (key.length !== 32) process.exit(2);
const ts = Math.floor(Date.now() / 300000) * 300000;
const iv = crypto.createHash("sha256").update(`${epoch}:${buildId}:${qh}:${ts}:${lane}`).digest().subarray(0, 12);
const payload = JSON.stringify({v: 1, ts, epoch: Number(epoch), buildId, qh, k: lane});
const cipher = crypto.createCipheriv("aes-256-gcm", key, iv);
const encrypted = Buffer.concat([cipher.update(payload, "utf8"), cipher.final()]);
process.stdout.write(Buffer.concat([Buffer.from([1]), iv, encrypted, cipher.getAuthTag()]).toString("base64"));
' "$_query_hash" "$allanime_aa_epoch" "$allanime_build_id" "$allanime_key" "$allanime_lane" 2>/dev/null && return 0
    fi

    _python_cmd="$(ani_watch_python || true)"
    if [ -n "$_python_cmd" ]; then
        "$_python_cmd" -c '
import base64
import hashlib
import json
import sys
import time

try:
    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
except Exception:
    raise SystemExit(2)

qh = sys.argv[1]
epoch = sys.argv[2]
build_id = sys.argv[3]
key = bytes.fromhex(sys.argv[4])
lane = sys.argv[5]
if len(key) != 32:
    raise SystemExit(2)
ts = (int(time.time() * 1000) // 300000) * 300000
iv = hashlib.sha256(f"{epoch}:{build_id}:{qh}:{ts}:{lane}".encode()).digest()[:12]
payload = json.dumps({"v": 1, "ts": ts, "epoch": int(epoch), "buildId": build_id, "qh": qh, "k": lane}, separators=(",", ":")).encode()
sys.stdout.write(base64.b64encode(b"\x01" + iv + AESGCM(key).encrypt(iv, payload, None)).decode())
' "$_query_hash" "$allanime_aa_epoch" "$allanime_build_id" "$allanime_key" "$allanime_lane" 2>/dev/null && return 0
    fi

    make_aa_req_openssl "$_query_hash"
}

decode_tobeparsed() {
    plain="$(decode_tobeparsed_legacy_plain "$1" || true)"
    sources="$(extract_source_urls "$plain")"
    [ -n "$sources" ] && printf '%s' "$sources" && return 0

    plain="$(decode_tobeparsed_aa_req_plain "$1" || true)"
    sources="$(extract_source_urls "$plain")"
    [ -n "$sources" ] && printf '%s' "$sources" && return 0

    return 1
}

extract_source_urls() {
    printf '%s' "$1" | tr '{}' '\n' |
        sed -nE 's|.*"sourceUrl":"([^"]*)".*"sourceName":"([^"]*)".*|\2 :\1|p' |
        sed 's|\\u002F|/|g;s|\\/|/|g;s|\\u0026|\&|g;s|\\u003D|=|g;s|\\||g'
}

episode_sources_from_api_response() {
    if printf "%s" "$1" | grep -q '"tobeparsed"'; then
        blob="$(printf "%s" "$1" | sed -nE 's|.*"tobeparsed":"([^"]*)".*|\1|p')"
        decode_tobeparsed "$blob"
    else
        extract_source_urls "$1"
    fi
}

b64url_to_hex() {
    _len=$(printf '%s' "$1" | wc -c | tr -d ' ')
    _mod=$((_len % 4))
    case $_mod in
        2) _pad="==" ;;
        3) _pad="=" ;;
        *) _pad="" ;;
    esac
    printf '%s%s' "$1" "$_pad" | tr -- '-_' '+/' | base64 -d | od -A n -t x1 | tr -d ' \n'
}

get_filemoon_links() {
    response="$(curl -e "$allanime_refr" -s "https://${allanime_base}$1" -A "$agent")"
    _fm_json="$(printf '%s' "$response" | tr -d '\n ' | tr ',' '\n')"
    iv="$(printf '%s' "$_fm_json" | sed -nE 's|^"iv":"([^"]*)"$|\1|p')"
    payload="$(printf '%s' "$_fm_json" | sed -nE 's|^"payload":"([^"]*)"$|\1|p')"
    kp1="$(printf '%s' "$_fm_json" | sed -nE 's|^"key_parts":\["([^"]*)"$|\1|p')"
    kp2="$(printf '%s' "$_fm_json" | sed -nE 's|^"([A-Za-z0-9_-]+)"\]$|\1|p' | head -1)"
    _kp1_hex="$(b64url_to_hex "$kp1")"
    _kp2_hex="$(b64url_to_hex "$kp2")"
    key_hex="$_kp1_hex$_kp2_hex"
    iv_hex="$(b64url_to_hex "$iv")00000002"
    tmp="$(mktemp)"
    _fm_len=$(printf '%s' "$payload" | wc -c | tr -d ' ')
    _fm_mod=$((_fm_len % 4))
    case $_fm_mod in
        2) _fm_pad="==" ;;
        3) _fm_pad="=" ;;
        *) _fm_pad="" ;;
    esac
    printf '%s%s' "$payload" "$_fm_pad" | tr -- '-_' '+/' | base64 -d >"$tmp"
    ct_len=$(($(wc -c <"$tmp") - 16))
    plain="$(dd if="$tmp" bs=1 count="$ct_len" 2>/dev/null | openssl enc -d -aes-256-ctr -K "$key_hex" -iv "$iv_hex" -nosalt -nopad 2>/dev/null)"
    rm -f "$tmp"
    printf '%s' "$plain" | tr '{}[]' '\n' |
        sed -nE 's|.*"url":"([^"]*)".*"height":([0-9]+).*|\2 >\1|p;s|.*"height":([0-9]+).*"url":"([^"]*)".*|\1 >\2|p' |
        sed 's|\\u0026|\&|g;s|\\u003D|=|g' | sort -rn
    printf "\033[1;32m%s\033[0m Links Fetched\n" "Filemoon" 1>&2
}

# gets embed urls, collects direct links into provider files, selects one with desired quality into $episode
get_episode_url() {
    unset episode links subtitle subs_flag refr_flag m3u8_refr result
    allanime_failure=""

    #shellcheck disable=SC2016
    episode_embed_gql='query ($showId: String!, $translationType: VaildTranslationTypeEnumType!, $episodeString: String!) { episode( showId: $showId translationType: $translationType episodeString: $episodeString ) { episodeString sourceUrls }}'

    query_hash="f4662f4b7510b26795dd53ef824a0bf1740fbbc5d1273fab18222ac831bca8d0"
    query_vars="{\"showId\":\"$id\",\"translationType\":\"$mode\",\"episodeString\":\"$ep_no\"}"

    [ "$allanime_crypto_cache_loaded" = "1" ] || load_allanime_crypto_config force
    aa_req="$(make_aa_req "$query_hash" || true)"
    if [ -n "$aa_req" ]; then
        query_ext="{\"persistedQuery\":{\"version\":1,\"sha256Hash\":\"$query_hash\"},\"k\":\"$allanime_lane\",\"aaReq\":\"$aa_req\"}"
        api_resp="$(curl -e "$allanime_api_refr" -sG -A "$agent" -H "Origin: ${allanime_api_refr}" -H "x-build-id: ${allanime_build_id}" "${allanime_api}/api" --data-urlencode "variables=${query_vars}" --data-urlencode "extensions=${query_ext}")"
        resp="$(episode_sources_from_api_response "$api_resp" || true)"
        api_error="$(printf "%s" "$api_resp" | sed -nE 's|.*"message":"([^"]+)".*|\1|p' | head -1)"
        retry_after="$(printf "%s" "$api_error" | sed -nE 's|.*try again in ([0-9]+) seconds?.*|\1|p')"
    else
        api_resp=""
        resp=""
        api_error="AA_CRYPTO_MISSING"
        retry_after=""
    fi

    if [ -z "$resp" ] && [ -z "$retry_after" ] && { allanime_crypto_error_needs_refresh "$api_error" || printf "%s" "$api_resp" | grep -q '"tobeparsed"'; }; then
        load_allanime_crypto_config force
        aa_req="$(make_aa_req "$query_hash" || true)"
        if [ -n "$aa_req" ]; then
            query_ext="{\"persistedQuery\":{\"version\":1,\"sha256Hash\":\"$query_hash\"},\"k\":\"$allanime_lane\",\"aaReq\":\"$aa_req\"}"
            api_resp="$(curl -e "$allanime_api_refr" -sG -A "$agent" -H "Origin: ${allanime_api_refr}" -H "x-build-id: ${allanime_build_id}" "${allanime_api}/api" --data-urlencode "variables=${query_vars}" --data-urlencode "extensions=${query_ext}")"
            resp="$(episode_sources_from_api_response "$api_resp" || true)"
            api_error="$(printf "%s" "$api_resp" | sed -nE 's|.*"message":"([^"]+)".*|\1|p' | head -1)"
            retry_after="$(printf "%s" "$api_error" | sed -nE 's|.*try again in ([0-9]+) seconds?.*|\1|p')"
            [ -n "$resp" ] && save_allanime_crypto_cache
        fi
    fi

    [ -z "$resp" ] && [ -n "$retry_after" ] && allanime_failure="AllAnime rate-limited episode source requests. Wait about ${retry_after}s before trying again."

    if [ -z "$resp" ] && [ -z "$retry_after" ] && [ -z "$allanime_failure" ] && ! allanime_crypto_error_needs_refresh "$api_error"; then
        query_ext="{\"persistedQuery\":{\"version\":1,\"sha256Hash\":\"$query_hash\"},\"k\":\"$allanime_lane\"}"
        api_resp="$(curl -e "$allanime_api_refr" -sG -A "$agent" -H "Origin: ${allanime_api_refr}" -H "x-build-id: ${allanime_build_id}" "${allanime_api}/api" --data-urlencode "variables=${query_vars}" --data-urlencode "extensions=${query_ext}")"
        resp="$(episode_sources_from_api_response "$api_resp" || true)"
        api_error="$(printf "%s" "$api_resp" | sed -nE 's|.*"message":"([^"]+)".*|\1|p' | head -1)"
        retry_after="$(printf "%s" "$api_error" | sed -nE 's|.*try again in ([0-9]+) seconds?.*|\1|p')"
    fi

    if [ -z "$resp" ] && [ -z "$retry_after" ] && [ -z "$allanime_failure" ] && [ "$api_error" != "AA_CRYPTO_MISSING" ]; then
        api_resp="$(curl -e "$allanime_api_refr" -s -H "Content-Type: application/json" -H "Origin: ${allanime_api_refr}" -X POST "${allanime_api}/api" --data "{\"variables\":{\"showId\":\"$id\",\"translationType\":\"$mode\",\"episodeString\":\"$ep_no\"},\"query\":\"$episode_embed_gql\"}" -A "$agent")"
        resp="$(episode_sources_from_api_response "$api_resp" || true)"
        api_error="$(printf "%s" "$api_resp" | sed -nE 's|.*"message":"([^"]+)".*|\1|p' | head -1)"
        retry_after="$(printf "%s" "$api_error" | sed -nE 's|.*try again in ([0-9]+) seconds?.*|\1|p')"
    fi

    if [ -z "$resp" ] && [ -z "$allanime_failure" ]; then
        if [ -n "$retry_after" ]; then
            allanime_failure="AllAnime rate-limited episode source requests. Wait about ${retry_after}s before trying again."
        elif [ "$api_error" = "AA_CRYPTO_MISSING" ]; then
            allanime_failure="AllAnime rejected the episode source request (AA_CRYPTO_MISSING) after refreshing crypto material."
        elif [ "$api_error" = "AA_CRYPTO_MISSING_BUILD" ]; then
            allanime_failure="AllAnime rejected the episode source request (AA_CRYPTO_MISSING_BUILD) after refreshing runtime crypto material."
        elif printf "%s" "$api_resp" | grep -q '"tobeparsed"'; then
            allanime_failure="AllAnime returned encrypted episode sources, but neither the upstream decoder nor the aaReq fallback decoded them."
        elif [ -n "$api_error" ]; then
            allanime_failure="AllAnime source request failed: $api_error."
        else
            allanime_failure="AllAnime returned no episode sources."
        fi
    fi

    if [ -n "$resp" ]; then
        cache_dir="$(mktemp -d)"
        providers="$(printf "%s\n" "$resp" | sed -nE 's|^([^[:space:]][^:]*) :.*|\1|p')"
        [ -z "$providers" ] && providers="Default Mp4 Yt-mp4 S-mp4 Luf-Mp4 Fm-mp4 Ak Uv-mp4"
        for provider in $providers; do
            cache_file="$(printf "%s" "$provider" | tr -c '[:alnum:]_-' '_')"
            generate_link "$provider" >"$cache_dir"/"$cache_file" &
        done
        wait
        links=$(cat "$cache_dir"/* 2>/dev/null | sort -g -r -s)
        rm -r "$cache_dir"
        links="$(prefer_playable_links "$links")"
        select_quality "$quality"
        [ -n "$episode" ] && return 0
        allanime_failure="Episode is released, but AllAnime returned no valid playable sources for this episode."
    fi

    printf "%s" "$ep_list" | grep -q "^$ep_no$" || die "Episode not released!"

    printf "\033[1;33m%s\033[0m\n" "${allanime_failure} Trying anidb.app fallback..." 1>&2
    anidb_links_file="$(mktemp)"
    anidb_fetch_episode_links "$title" >"$anidb_links_file" || true
    links="$(cat "$anidb_links_file")"
    rm -f "$anidb_links_file"
    if [ -n "$links" ]; then
        links="$(prefer_playable_links "$links")"
        select_quality "$quality"
        if [ -n "$episode" ]; then
            refr_flag="--referrer=https://anidb.app"
            m3u8_refr="https://anidb.app"
            printf "\033[1;32m%s\033[0m Links Fetched\n" "anidb.app" 1>&2
            return 0
        fi
        anidb_last_error="anidb.app returned streams, but no playable quality matched"
    fi

    [ -n "$anidb_last_error" ] && die "${allanime_failure} anidb.app fallback also failed: ${anidb_last_error}."
    die "$allanime_failure"
}

# search the query and give results
search_anime() {
    #shellcheck disable=SC2016
    search_gql='query( $search: SearchInput $limit: Int $page: Int $translationType: VaildTranslationTypeEnumType $countryOrigin: VaildCountryOriginEnumType ) { shows( search: $search limit: $limit page: $page translationType: $translationType countryOrigin: $countryOrigin ) { edges { _id name englishName nativeName availableEpisodes __typename } }}'

    search_resp=$(curl -e "$allanime_api_refr" -s -H "Content-Type: application/json" -H "Origin: ${allanime_api_refr}" -X POST "${allanime_api}/api" --data "{\"variables\":{\"search\":{\"allowAdult\":true,\"allowUnknown\":true,\"query\":\"$1\"},\"limit\":40,\"page\":1,\"translationType\":\"$mode\",\"countryOrigin\":\"ALL\"},\"query\":\"$search_gql\"}" -A "$agent")
    if command -v python3 >/dev/null 2>&1; then
        printf '%s' "$search_resp" | python3 -c '
import json
import re
import sys
import urllib.parse

mode = sys.argv[1]
query = urllib.parse.unquote_plus(sys.argv[2]) if len(sys.argv) > 2 else ""

def normalized(value):
    value = (value or "").casefold()
    value = re.sub(r"[^a-z0-9]+", " ", value)
    return " ".join(value.split())

query_norm = normalized(query)
query_terms = set(query_norm.split())

def episode_count(item):
    episodes = (item.get("availableEpisodes") or {}).get(mode)
    try:
        return int(episodes)
    except (TypeError, ValueError):
        return 0

def title_score(item, original_index):
    titles = [
        (item.get("name") or "").strip(),
        (item.get("englishName") or "").strip(),
        (item.get("nativeName") or "").strip(),
    ]
    title_norms = [normalized(title) for title in titles if title]
    if not query_norm or not title_norms:
        return (9, 9, -episode_count(item), original_index)

    if any(title == query_norm for title in title_norms):
        return (0, 0, -episode_count(item), original_index)

    penalties = []
    ranks = []
    for title in title_norms:
        if title.startswith(f"{query_norm} "):
            ranks.append(1)
        elif query_norm in title:
            ranks.append(2)
        elif query_terms and query_terms.issubset(set(title.split())):
            ranks.append(3)
        else:
            continue

        special = bool(re.search(r"\b(season|part|movie|special|ova|ona|mini|recap|pv)\b", title))
        penalties.append(1 if special else 0)

    if not ranks:
        return (8, 8, -episode_count(item), original_index)
    return (min(ranks), min(penalties or [0]), -episode_count(item), original_index)

try:
    edges = (((json.load(sys.stdin).get("data") or {}).get("shows") or {}).get("edges") or [])
except Exception:
    edges = []
ranked_edges = sorted(enumerate(edges), key=lambda pair: title_score(pair[1], pair[0]))
for _index, item in ranked_edges:
    episodes = episode_count(item)
    if episodes <= 0:
        continue
    name = (item.get("name") or "").strip()
    english = (item.get("englishName") or "").strip()
    if english and name and english.casefold() != name.casefold():
        title = f"{english} ({name})"
    else:
        title = english or name
    show_id = item.get("_id")
    if show_id and title:
        print(f"{show_id}\t{title} ({episodes} episodes)")
' "$mode" "$1"
    else
        printf '%s' "$search_resp" | sed 's|Show|\
| g' | sed -nE "s|.*_id\":\"([^\"]*)\",\"name\":\"(.+)\",.*${mode}\":([1-9][^,]*).*|\1	\2 (\3 episodes)|p" | sed 's/\\"//g'
    fi
}

