ani_watch_playback_started() {
    ani_watch_hook playback-started --title "$title" --source-title "$title" --episode "$ep_no"
}

ani_watch_playback_finished() {
    ani_watch_exit_code=$1
    ani_watch_started_at=$2
    ani_watch_finished_at=$(date +%s)
    ani_watch_duration=$((ani_watch_finished_at - ani_watch_started_at))
    ani_watch_hook playback-finished --title "$title" --source-title "$title" --episode "$ep_no" --exit-code "$ani_watch_exit_code" --duration-seconds "$ani_watch_duration"
}

ani_watch_run_foreground() {
    ani_watch_started_at=$(date +%s)
    ani_watch_playback_started
    "$@"
    ani_watch_exit_code=$?
    ani_watch_playback_finished "$ani_watch_exit_code" "$ani_watch_started_at"
    return "$ani_watch_exit_code"
}

ani_watch_run_detached() {
    # shellcheck disable=SC2016
    nohup sh -c '
        ani_watch_title=$1
        ani_watch_episode=$2
        shift 2
        ani_watch_started_at=$(date +%s)
        if command -v ani-watch-hook >/dev/null 2>&1; then
            ani-watch-hook playback-started --title "$ani_watch_title" --source-title "$ani_watch_title" --episode "$ani_watch_episode" >/dev/null 2>&1 || true
        fi
        "$@"
        ani_watch_exit_code=$?
        ani_watch_finished_at=$(date +%s)
        ani_watch_duration=$((ani_watch_finished_at - ani_watch_started_at))
        if command -v ani-watch-hook >/dev/null 2>&1; then
            ani-watch-hook playback-finished --title "$ani_watch_title" --source-title "$ani_watch_title" --episode "$ani_watch_episode" --exit-code "$ani_watch_exit_code" --duration-seconds "$ani_watch_duration" >/dev/null 2>&1 || true
        fi
        exit "$ani_watch_exit_code"
    ' ani-watch-player "$title" "$ep_no" "$@" >/dev/null 2>&1 &
}

