extract_links_from_provider_response() {
    _provider_url=$1
    _python_cmd="$(ani_watch_python || true)"
    [ -n "$_python_cmd" ] || return 1

    "$_python_cmd" -c '
import html
import re
import sys

provider_url = sys.argv[1]
text = sys.stdin.read()
seen = set()
links = []


def clean(value):
    value = value or ""
    for _ in range(3):
        value = html.unescape(value)
    replacements = {
        "\\\\u0026": "&",
        "\\\\u003D": "=",
        "\\\\u003d": "=",
        "\\\\u002F": "/",
        "\\\\/": "/",
        "\\\\&quot;": "\"",
        "\\\\\"": "\"",
    }
    for old, new in replacements.items():
        value = value.replace(old, new)
    return value.replace("\\", "").strip()


def normalized(value):
    value = clean(value)
    for _ in range(2):
        value = html.unescape(value)
        value = value.replace("\\\\u0026", "&").replace("\\\\u003D", "=").replace("\\\\u003d", "=")
        value = value.replace("\\\\u002F", "/").replace("\\\\/", "/").replace("\\\\\"", "\"")
    return value


def quality_for_name(name, url=""):
    label = (name or "").strip().lower()
    if label in {"hls", "mp4", "direct", "iframe"}:
        return name or ""
    match = re.search(r"([1-9][0-9]{2,3})\s*p?", label)
    if not match and not label:
        match = re.search(r"([1-9][0-9]{2,3})\s*p?", url)
    if match:
        return match.group(1)
    return {
        "mobile": "144",
        "lowest": "240",
        "low": "360",
        "sd": "480",
        "hd": "720",
        "full": "1080",
        "quad": "1440",
        "ultra": "2160",
    }.get(label, name or "")


def add(label, url):
    url = clean(url)
    if not url or not re.match(r"https?://", url):
        return
    if str(label or "").strip().lower().startswith("dash") or "/apiak/" in url:
        return
    label = quality_for_name(label, url) or ("Hls" if ".m3u8" in url else "Mp4" if ".mp4" in url else "Direct")
    item = (label, url)
    if item in seen:
        return
    seen.add(item)
    links.append(item)


body = normalized(text)
if re.search(r"\.(?:m3u8|mp4)(?:[?#]|$)", provider_url, re.IGNORECASE):
    add("Hls" if ".m3u8" in provider_url.lower() else "Mp4", provider_url)

for name, url in re.findall(r"\"name\"\s*:\s*\"([^\"]+)\"\s*,\s*\"url\"\s*:\s*\"([^\"]+)\"", body):
    add(name, url)

for url in re.findall(r"\"hlsManifestUrl\"\s*:\s*\"([^\"]+)\"", body):
    add("Hls", url)

patterns = [
    r"\"(?:resolutionStr|resolution|quality)\"\s*:\s*\"([^\"]+)\".{0,600}?\"(?:link|url|file|src|source)\"\s*:\s*\"([^\"]+)\"",
    r"\"(?:link|url|file|src|source)\"\s*:\s*\"([^\"]+)\".{0,600}?\"(?:resolutionStr|resolution|quality)\"\s*:\s*\"([^\"]+)\"",
]
for pattern in patterns:
    for first, second in re.findall(pattern, body, flags=re.IGNORECASE | re.DOTALL):
        if first.startswith("http"):
            add(second, first)
        else:
            add(first, second)

for url in re.findall(r"https?://[^\"'\''<>\s]+(?:\.m3u8|\.mp4)(?:[^\"'\''<>\s]*)?", body, flags=re.IGNORECASE):
    add("Hls" if ".m3u8" in url.lower() else "Mp4", url)

for label, url in links:
    print(f"{label} >{url}")
' "$_provider_url" 2>/dev/null
}

# extract the video links from response of embed urls, extract mp4 links form m3u8 lists
get_links() {
    case "$*" in
        *tools.fast4speed.rsvp*)
            printf "%s\n" "Yt >$*"
            printf "\033[1;32m%s\033[0m Links Fetched\n" "$provider_name" 1>&2
            return 0
            ;;
        *mp4upload.com*)
            response="$(curl -L --connect-timeout 10 --max-time 25 -e "$allanime_refr" -s "$*" -A "$agent")"
            mp4_link="$(printf '%s' "$response" | sed -nE 's#.*(src|file):[[:space:]]*"([^"]+\.mp4[^"]*)".*#\2#p' | head -1 | sed 's|\\u0026|\&|g;s|\\||g')"
            [ -n "$mp4_link" ] && printf "%s\n" "Mp4 >$mp4_link"
            printf "\033[1;32m%s\033[0m Links Fetched\n" "$provider_name" 1>&2
            return 0
            ;;
    esac

    if printf '%s' "$*" | grep -Eq '^https?://'; then
        if printf '%s' "$*" | grep -q 'ok\.ru/videoembed/'; then
            printf "%s >%s\n" "$provider_name" "$*"
            printf "\033[1;32m%s\033[0m Links Fetched\n" "$provider_name" 1>&2
            return 0
        fi
        response="$(curl -L --connect-timeout 10 --max-time 25 -e "$allanime_api_refr" -s "$*" -A "$agent")"
        provider_links="$(printf '%s' "$response" | extract_links_from_provider_response "$*" || true)"
        if [ -n "$provider_links" ]; then
            printf "%s\n" "$provider_links"
        else
            printf "%s >%s\n" "$provider_name" "$*"
        fi
        printf "\033[1;32m%s\033[0m Links Fetched\n" "$provider_name" 1>&2
        return 0
    fi

    response="$(curl -L --connect-timeout 10 --max-time 25 -e "$allanime_refr" -s "https://${allanime_base}$*" -A "$agent")"
    episode_link="$(printf '%s' "$response" | sed 's|},{|\
|g' | sed -nE 's|.*link":"([^"]*)".*"resolutionStr":"([^"]*)".*|\2 >\1|p;s|.*"resolutionStr":"([^"]*)".*"link":"([^"]*)".*|\1 >\2|p;s|.*hls","url":"([^"]*)".*"hardsub_lang":"en-US".*|\1|p' | sed '/^Dash[[:space:]]/d')"
    if [ -z "$episode_link" ]; then
        episode_link="$(printf '%s' "$response" | extract_links_from_provider_response "https://${allanime_base}$*" || true)"
    fi

    case "$episode_link" in
        *repackager.wixmp.com*)
            extract_link=$(printf "%s" "$episode_link" | cut -d'>' -f2 | sed 's|repackager.wixmp.com/||g;s|\.urlset.*||g')
            for j in $(printf "%s" "$episode_link" | sed -nE 's|.*/,([^/]*),/mp4.*|\1|p' | sed 's|,|\
|g'); do
                printf "%s >%s\n" "$j" "$extract_link" | sed "s|,[^/]*|${j}|g"
            done | sort -nr
            ;;
        *master.m3u8*)
            m3u8_refr=$(printf '%s' "$response" | sed -nE 's|.*Referer":"([^"]*)".*|\1|p') && printf '%s\n' "m3u8_refr >$m3u8_refr" >"$cache_dir/m3u8_refr"
            extract_link=$(printf "%s" "$episode_link" | head -1 | cut -d'>' -f2)
            relative_link=$(printf "%s" "$extract_link" | sed 's|[^/]*$||')
            m3u8_streams="$(curl -e "$m3u8_refr" -s "$extract_link" -A "$agent")"
            printf "%s" "$m3u8_streams" | grep -q "EXTM3U" && printf "%s" "$m3u8_streams" | sed 's|^#EXT-X-STREAM.*x||g; s|,.*|p|g; /^#/d; $!N; s|\n| >|;/EXT-X-I-FRAME/d' |
                sed "s|>|cc>${relative_link}|g" | sort -nr
            printf '%s' "$response" | sed -nE 's|.*"subtitles":\[\{"lang":"en","label":"English","default":"default","src":"([^"]*)".*|subtitle >\1|p' >"$cache_dir/suburl"
            ;;
        *) [ -n "$episode_link" ] && printf "%s\n" "$episode_link" ;;
    esac

    printf "\033[1;32m%s\033[0m Links Fetched\n" "$provider_name" 1>&2
}

# initialises provider_name and provider_id. First argument is the provider name, 2nd is the regex that matches that provider's link
provider_init() {
    provider_name=$1
    provider_id=$(printf "%s" "$resp" | sed -n "$2" | head -1 | sed 's/^[^:]*://')
    case "$provider_id" in
        --*) provider_id="$(printf "%s" "${provider_id#--}" | decode_provider_id)" ;;
        http* | /* | "") ;;
        *) provider_id="$(printf "%s" "$provider_id" | decode_provider_id)" ;;
    esac
}

# generates links based on given provider
generate_link() {
    case $1 in
        1 | Default) provider_init "wixmp" "/Default :/p" ;;       # wixmp(default)(m3u8)(multi) -> (mp4)(multi)
        2 | Mp4) provider_init "mp4upload" "/Mp4 :/p" ;;           # mp4upload(mp4)(single)
        3 | Yt-mp4) provider_init "youtube" "/Yt-mp4 :/p" ;;       # youtube(mp4)(single)
        4 | S-mp4) provider_init "sharepoint" "/S-mp4 :/p" ;;      # sharepoint(mp4)(single)
        5 | Fm-mp4) provider_init "filemoon" "/Fm-mp4 :/p" ;;      # filemoon(m3u8)(single)
        6 | Luf-Mp4 | Luf-mp4) provider_init "hianime" "/Luf-[Mm]p4 :/p" ;; # hianime(m3u8)(multi)
        Ak) provider_init "ak" "/Ak :/p" ;;
        Uv-mp4) provider_init "usercloud" "/Uv-mp4 :/p" ;;
        *) provider_init "$1" "/$1 :/p" ;;
    esac
    if { [ "$1" = "5" ] || [ "$1" = "Fm-mp4" ]; } && [ -n "$provider_id" ]; then
        get_filemoon_links "$provider_id"
    else
        [ -n "$provider_id" ] && get_links "$provider_id"
    fi
}

select_quality() {
    # removing urls which have soft subs to avoid playing on android, iSH and vlc (m3u8 streams don't get correct referrer)
    printf '%s' "$player_function" | cut -f1 -d" " | grep -qE '(android|iSH|vlc)' && links=$(printf '%s' "$links" | sed '/cc>/d;/subtitle >/d;/m3u8_refr >/d')
    printf '%s' "$player_function" | cut -f1 -d" " | grep -qE '(android|iSH)' && links=$(printf '%s' "$links" | sed '/Yt >/d')
    case "$1" in
        best) result=$(printf "%s" "$links" | head -n1) ;;
        worst) result=$(printf "%s" "$links" | grep -E '^[0-9]{3,4}' | tail -n1) ;;
        *) result=$(printf "%s" "$links" | grep -m 1 "$1") ;;
    esac
    [ -z "$result" ] && printf "Specified quality not found, defaulting to best\n" 1>&2 && result=$(printf "%s" "$links" | head -n1)

    # add refr,sub flags for m3u8 and refr flag for yt
    printf '%s' "$result" | grep -q "cc>" && subtitle="$(printf '%s' "$links" | sed -nE 's|subtitle >(.*)|\1|p')" &&
        [ -n "$subtitle" ] && subs_flag="--sub-file=$subtitle"
    printf '%s' "$result" | grep -q "cc>" && m3u8_refr="$(printf '%s' "$links" | sed -nE 's|m3u8_refr >(.*)|\1|p')" && refr_flag="--referrer=$m3u8_refr"
    printf "%s" "$result" | grep -q "tools.fast4speed.rsvp" && refr_flag="--referrer=$allanime_refr"
    printf "%s" "$result" | grep -q "mp4upload.com" && refr_flag="--referrer=https://www.mp4upload.com/"
    printf "%s" "$result" | grep -q "ok.ru/videoembed" && refr_flag="--referrer=${allanime_api_refr}/"
    printf "%s" "$result" | grep -q "okcdn.ru" && refr_flag="--referrer=https://ok.ru/"

    ! (printf '%s' "$result" | grep -qE "(cc>|tools.fast4speed.rsvp|mp4upload.com|ok\.ru/videoembed|okcdn\.ru)") && unset refr_flag
    ! (printf '%s' "$result" | grep -q "cc>") && unset subs_flag
    episode=$(printf "%s" "$result" | cut -d'>' -f2)
}

prefer_playable_links() {
    _preferred_links="$(printf '%s\n' "$1" | awk '
{
    line = $0
    lower = tolower(line)
    if (lower ~ /^(subtitle|m3u8_refr)[[:space:]]*>/) {
        print line
        next
    }
    if (lower ~ /cc>/) {
        print line
        next
    }
    if (lower ~ /tools\.fast4speed\.rsvp/) {
        print line
        next
    }
    if (lower ~ /ok\.ru\/videoembed\//) {
        print line
        next
    }
    if (lower ~ />https?:\/\/[^[:space:]]+\.(mp4|m3u8)([?#][^[:space:]]*)?$/) {
        print line
    }
}
')"
    [ -n "$_preferred_links" ] && printf '%s\n' "$_preferred_links" && return 0
    printf '%s\n' "$1"
}

