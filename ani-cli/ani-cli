generate_allanime_aa_boot() {
    command -v openssl >/dev/null 2>&1 || return 1
    [ -n "$allanime_build_id" ] || return 1
    printf '%s' "$allanime_key_a" | grep -Eq '^[0-9a-f]{64}$' || return 1

    _hmac_key_hex="$(
        printf 'aa-boot:%s' "$allanime_build_id" |
            openssl dgst -sha256 -mac HMAC -macopt "hexkey:$allanime_key_a" -binary 2>/dev/null |
            od -An -tx1 -v |
            tr -d ' \n'
    )"
    printf '%s' "$_hmac_key_hex" | grep -Eq '^[0-9a-f]{64}$' || return 1
    _boot_payload="${allanime_build_id}:mkissa:mkissa.to:${allanime_aa_epoch}"
    [ -n "$allanime_lane" ] && _boot_payload="${_boot_payload}:${allanime_lane}"
    printf '%s' "$_boot_payload" |
        openssl dgst -sha256 -mac HMAC -macopt "hexkey:$_hmac_key_hex" 2>/dev/null |
        sed 's/^.*= //'
}

