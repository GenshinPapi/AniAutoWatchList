episode = episodes[relative_index - 1]
if isinstance(episode, dict) and episode.get("id") is not None:
    print(episode["id"])
    raise SystemExit(0)

raise SystemExit(1)
' "$_anidb_ep_no" 2>/dev/null && return 0
