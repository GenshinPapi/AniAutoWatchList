    _app_url="$(printf '%s' "$_crypto_html" | grep -Eo 'https://cdn\.(mkissa\.net|allanime\.day)/all/mk/_app/immutable/entry/app\.[^"]+\.js' | head -n 1)"
    if [ -z "$_app_url" ]; then
        _app_path="$(printf '%s' "$_crypto_html" | grep -Eo '/all/mk/_app/immutable/entry/app\.[^"]+\.js' | head -n 1)"
        [ -n "$_app_path" ] && _app_url="https://cdn.mkissa.net$_app_path"
    fi

    _chunk_url=""
    _chunk_js=""
    _key_a=""
    _build_id=""
    _lane=""
    if [ -n "$_app_url" ]; then
        _app_js="$(curl -L --connect-timeout 3 --max-time 8 -fsSL "$_app_url" 2>/dev/null || true)"
        _chunks_file="$(mktemp)"
        _chunk_base="$(printf '%s' "$_app_url" | sed -nE 's|/entry/[^/]+\.js$|/chunks|p')"
        printf '%s' "$_app_js" | grep -Eo "\.\./chunks/[^\"',\\\\]+\.js" | sed 's|^\.\./chunks/||' | awk '!seen[$0]++' >"$_chunks_file"
        while IFS= read -r _chunk_path; do
            if [ -z "$_chunk_base" ] || [ -z "$_chunk_path" ]; then
                continue
            fi
            _candidate_url="$_chunk_base/$_chunk_path"
            _candidate_js="$(curl -L --connect-timeout 3 --max-time 8 -fsSL "$_candidate_url" 2>/dev/null || true)"
            _candidate_key_a="$(extract_allanime_key_a "$_candidate_js")"
            _candidate_build_id="$(extract_allanime_build_id "$_candidate_js")"
            _candidate_lane="$(extract_allanime_lane "$_candidate_js")"
            if [ -n "$_candidate_build_id" ] && [ -n "$_candidate_lane" ]; then
                _chunk_url=$_candidate_url
                _chunk_js=$_candidate_js
                _key_a=$_candidate_key_a
                _build_id=$_candidate_build_id
                _lane=$_candidate_lane
                break
            elif [ -z "$_chunk_js" ] && { [ -n "$_candidate_build_id" ] || [ -n "$_candidate_lane" ] || printf '%s' "$_candidate_key_a" | grep -Eq '^[0-9a-f]{64}$'; }; then
                _chunk_url=$_candidate_url
                _chunk_js=$_candidate_js
                _key_a=$_candidate_key_a
                _build_id=$_candidate_build_id
                _lane=$_candidate_lane
            fi
        done <"$_chunks_file"
        if [ -z "$_chunk_js" ]; then
            _chunk_path="$(head -n 1 "$_chunks_file")"
            if [ -n "$_chunk_base" ] && [ -n "$_chunk_path" ]; then
                _chunk_url="$_chunk_base/$_chunk_path"
            fi
        fi
        rm -f "$_chunks_file"
    fi
    [ -z "$_chunk_url" ] && _chunk_url="https://cdn.allanime.day/all/mk/_app/immutable/chunks/DNe1e6Xy.js"
    [ -z "$_chunk_js" ] && _chunk_js="$(curl -L --connect-timeout 3 --max-time 8 -fsSL "$_chunk_url" 2>/dev/null || true)"

    [ -z "$_key_a" ] && _key_a="$(extract_allanime_key_a "$_chunk_js")"
    [ -z "$_build_id" ] && _build_id="$(extract_allanime_build_id "$_chunk_js")"
    [ -z "$_lane" ] && _lane="$(extract_allanime_lane "$_chunk_js")"

    _generated_epoch="$(generate_allanime_epoch || true)"
    case "$_generated_epoch" in
        '' | *[!0-9]*) ;;
        *) allanime_aa_epoch=$_generated_epoch ;;
    esac
    [ -n "$_part_b" ] && allanime_key_b=$_part_b
    [ -n "$_build_id" ] && allanime_build_id=$_build_id
    [ -n "$_lane" ] && allanime_lane=$_lane
    _generated_mask="$(generate_allanime_mask || true)"
    if printf '%s' "$_generated_mask" | grep -Eq '^[0-9a-f]{64}$'; then
        allanime_key_a=$_generated_mask
    elif printf '%s' "$_key_a" | grep -Eq '^[0-9a-f]{64}$'; then
        allanime_key_a=$_key_a
    fi

    if [ -n "$allanime_build_id" ]; then
        _bootstrap_origin="$(allanime_bootstrap_origin)"
        _bootstrap_url="${_bootstrap_origin}/client-crypto/v1/bootstrap?buildId=${allanime_build_id}"
        [ -n "$allanime_lane" ] && _bootstrap_url="${_bootstrap_url}&k=${allanime_lane}"
        _aa_boot="$(generate_allanime_aa_boot || true)"
        _bootstrap_json=""
        if [ -n "$_aa_boot" ]; then
            _bootstrap_json="$(curl -L --connect-timeout 3 --max-time 8 -fsSL -A "$agent" -e "$allanime_api_refr" -H "Origin: ${allanime_api_refr}" -H "Referer: ${allanime_api_refr}/" -H "x-build-id: ${allanime_build_id}" -H "x-aa-boot: ${_aa_boot}" "$_bootstrap_url" 2>/dev/null || true)"
        fi
        _bootstrap_epoch="$(printf '%s' "$_bootstrap_json" | sed -nE 's/.*"epoch":([0-9]+).*/\1/p' | head -n 1)"
        _bootstrap_part_b="$(printf '%s' "$_bootstrap_json" | sed -nE 's/.*"partB":"([^"]+)".*/\1/p' | head -n 1)"
        if [ -z "$_bootstrap_part_b" ]; then
            _bootstrap_part_b="$(printf '%s' "$_bootstrap_json" | sed -nE 's/.*partB[^A-Za-z0-9+/=]*([A-Za-z0-9+/=]{20,}).*/\1/p' | head -n 1)"
        fi
        case "$_bootstrap_epoch" in
            '' | *[!0-9]*) ;;
            *) allanime_aa_epoch=$_bootstrap_epoch ;;
        esac
        [ -n "$_bootstrap_part_b" ] && allanime_key_b=$_bootstrap_part_b
    fi

    _derived_key="$(derive_allanime_key_hex "$allanime_key_a" "$allanime_key_b" || true)"
    if printf '%s' "$_derived_key" | grep -Eq '^[0-9a-f]{64}$'; then
        allanime_key=$_derived_key
        allanime_crypto_cache_loaded=1
        save_allanime_crypto_cache
    fi
}

decode_tobeparsed_legacy_plain() {
    tmp="$(mktemp)"
    printf '%s' "$1" | base64 -d >"$tmp" 2>/dev/null || {
        rm -f "$tmp"
        return 1
    }
    file_size="$(wc -c <"$tmp")"
    iv="$(dd if="$tmp" bs=1 skip=1 count=12 2>/dev/null | od -A n -t x1 | tr -d ' \n')"
    ctr="${iv}00000002"
    ct_len=$((file_size - 13 - 16))
    if [ "$ct_len" -le 0 ]; then
        rm -f "$tmp"
        return 1
    fi
    plain="$(dd if="$tmp" bs=1 skip=13 count="$ct_len" 2>/dev/null | openssl enc -d -aes-256-ctr -K "$allanime_legacy_key" -iv "$ctr" -nosalt -nopad 2>/dev/null)"
    rm -f "$tmp"
    [ -n "$plain" ] || return 1
    printf '%s' "$plain"
}

