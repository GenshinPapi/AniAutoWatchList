hex_to_bin() {
    _hex=$1
    _hex_len=${#_hex}
    _hex_i=0
    _hex_oct=""
    while [ "$_hex_i" -lt "$_hex_len" ]; do
        _hex_pair="$(printf '%s' "$_hex" | cut -c"$((_hex_i + 1))-$((_hex_i + 2))")"
        _hex_dec="$(printf '%d' "0x$_hex_pair")"
        _hex_oct="${_hex_oct}\\$(printf '%03o' "$_hex_dec")"
        _hex_i=$((_hex_i + 2))
    done
    printf '%b' "$_hex_oct"
}

# shellcheck disable=SC2034
hex_to_bytes16() {
    _bytes_hex=$1
    _bytes_i=0
    while [ "$_bytes_i" -lt 16 ]; do
        _bytes_pair="$(printf '%s' "$_bytes_hex" | cut -c"$((_bytes_i * 2 + 1))-$((_bytes_i * 2 + 2))")"
        eval "b$_bytes_i=\$(printf '%d' \"0x$_bytes_pair\")"
        _bytes_i=$((_bytes_i + 1))
    done
